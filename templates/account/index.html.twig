{% extends 'base.html.twig' %}

{% block title %}Mon compte — Covoite{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 py-8">

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 px-4 py-3 rounded-xl text-sm font-semibold
                {% if type == 'success' %}bg-lime/20 text-brand border border-lime/40
                {% elseif type == 'error' %}bg-red-50 text-red-700 border border-red-200
                {% else %}bg-amber-50 text-amber-800 border border-amber-200{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-extrabold text-brand">Bonjour, {{ app.user.firstName }}</h1>
            <p class="text-sm text-brand/40 mt-0.5">Bienvenue sur votre espace personnel</p>
        </div>
        <a href="{{ path('app_trip_new') }}"
           class="bg-lime hover:bg-lime/90 text-brand font-bold px-5 py-2.5 rounded-xl text-sm transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Proposer un trajet
        </a>
    </div>

    {% set now = date('now') %}
    {% set allDriverTrips = trips|default([]) %}
    {% set upcomingTrips  = allDriverTrips|filter(t => t.status.value == 'active' and t.departureAt >= now) %}
    {% set pastTrips      = allDriverTrips|filter(t => t.status.value == 'active' and t.departureAt < now) %}
    {% set completedTrips = allDriverTrips|filter(t => t.status.value == 'completed') %}

    {% set pendingBookingsAll = [] %}
    {% for trip in allDriverTrips %}
        {% for b in trip.bookings %}
            {% if b.status.value == 'pending' %}
                {% set pendingBookingsAll = pendingBookingsAll|merge([b]) %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    {# ── SECTION CONDUCTEUR ───────────────────────────────────────────── #}
    {% if allDriverTrips|length > 0 or pendingBookingsAll|length > 0 %}
    <div class="mb-10">
        <h2 class="text-lg font-extrabold text-brand mb-5 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0zM3 7h2l1.5 5h11L19 7H3zm2 5h14"/>
            </svg>
            En tant que conducteur
        </h2>

        {# Demandes en attente #}
        {% if pendingBookingsAll|length > 0 %}
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 mb-5">
            <p class="text-sm font-bold text-amber-800 mb-4">
                {{ pendingBookingsAll|length }} demande{% if pendingBookingsAll|length > 1 %}s{% endif %} en attente
            </p>
            <div class="space-y-3">
                {% for booking in pendingBookingsAll %}
                <div class="bg-white rounded-xl border border-amber-200/60 px-4 py-3 flex items-center justify-between gap-4 flex-wrap">
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-brand">
                            {{ booking.passenger.firstName }} {{ booking.passenger.lastName }}
                        </p>
                        <p class="text-xs text-brand/50">
                            {{ booking.trip.departureCity }} → {{ booking.trip.arrivalCity }}
                            · {{ booking.trip.departureAt|date('d/m/Y à H:i') }}
                            · {{ booking.seats }} place{% if booking.seats > 1 %}s{% endif %}
                        </p>
                        {% if booking.message %}
                            <p class="text-xs italic text-brand/40 mt-0.5">"{{ booking.message|slice(0, 80) }}{% if booking.message|length > 80 %}…{% endif %}"</p>
                        {% endif %}
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <form method="POST" action="{{ path('app_booking_confirm', {id: booking.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('confirm-booking-' ~ booking.id) }}">
                            <button type="submit" class="bg-lime hover:bg-lime/90 text-brand font-bold text-xs px-3.5 py-2 rounded-full transition">Confirmer</button>
                        </form>
                        <form method="POST" action="{{ path('app_booking_refuse', {id: booking.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('refuse-booking-' ~ booking.id) }}">
                            <button type="submit" class="bg-white hover:bg-red-50 text-red-600 border border-red-200 font-bold text-xs px-3.5 py-2 rounded-full transition">Refuser</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Trajets actifs à venir #}
        {% if upcomingTrips|length > 0 %}
        <div class="mb-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand/40 mb-3">Trajets à venir</p>
            <div class="space-y-3">
                {% for trip in upcomingTrips %}
                <div class="bg-white border border-black/8 rounded-2xl px-5 py-4 flex items-center justify-between gap-4 flex-wrap">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="w-2 h-2 rounded-full bg-lime shrink-0"></span>
                            <p class="font-semibold text-brand text-sm">{{ trip.departureCity }} → {{ trip.arrivalCity }}</p>
                        </div>
                        <p class="text-xs text-brand/50 ml-4">
                            {{ trip.departureAt|date('d/m/Y à H:i') }}
                            · {{ trip.availableSeats }} place{% if trip.availableSeats > 1 %}s{% endif %} dispo
                            · {{ trip.price }} €
                        </p>
                        {% set cc = trip.bookings|filter(b => b.status.value == 'confirmed')|length %}
                        {% set pc = trip.bookings|filter(b => b.status.value == 'pending')|length %}
                        {% if cc > 0 or pc > 0 %}
                        <p class="text-xs mt-0.5 ml-4">
                            {% if cc > 0 %}<span class="text-lime font-semibold">{{ cc }} passager{% if cc > 1 %}s{% endif %}</span>{% endif %}
                            {% if pc > 0 %}<span class="text-amber-600 font-semibold">{% if cc > 0 %} · {% endif %}{{ pc }} en attente</span>{% endif %}
                        </p>
                        {% endif %}
                    </div>
                    <div class="flex items-center gap-2 shrink-0 flex-wrap">
                        <a href="{{ path('app_trip_edit', {id: trip.id}) }}"
                           class="text-xs font-semibold text-brand border border-brand/15 bg-cream hover:bg-brand/8 px-3 py-1.5 rounded-full transition">Modifier</a>
                        <a href="{{ path('app_trip_show', {id: trip.id}) }}"
                           class="text-xs font-semibold text-brand border border-brand/15 bg-cream hover:bg-brand/8 px-3 py-1.5 rounded-full transition">Voir</a>
                        <form method="POST" action="{{ path('app_trip_cancel', {id: trip.id}) }}"
                              onsubmit="return confirm('Annuler ce trajet ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel-trip-' ~ trip.id) }}">
                            <button type="submit" class="text-xs font-semibold text-red-500 border border-red-200 bg-white hover:bg-red-50 px-3 py-1.5 rounded-full transition">Annuler</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Trajets actifs dont la date est passée → à marquer comme terminé #}
        {% if pastTrips|length > 0 %}
        <div class="mb-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-amber-700/60 mb-3">En attente de clôture</p>
            <div class="space-y-3">
                {% for trip in pastTrips %}
                <div class="bg-amber-50/60 border border-amber-200/60 rounded-2xl px-5 py-4 flex items-center justify-between gap-4 flex-wrap">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 mb-0.5">
                            <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
                            <p class="font-semibold text-brand text-sm">{{ trip.departureCity }} → {{ trip.arrivalCity }}</p>
                        </div>
                        <p class="text-xs text-brand/50 ml-4">
                            Départ : {{ trip.departureAt|date('d/m/Y à H:i') }}
                        </p>
                        {% set cc = trip.bookings|filter(b => b.status.value == 'confirmed')|length %}
                        {% if cc > 0 %}
                            <p class="text-xs mt-0.5 ml-4 text-brand/60 font-semibold">{{ cc }} passager{% if cc > 1 %}s{% endif %} confirmé{% if cc > 1 %}s{% endif %}</p>
                        {% endif %}
                    </div>
                    <form method="POST" action="{{ path('app_trip_complete', {id: trip.id}) }}"
                          onsubmit="return confirm('Marquer ce trajet comme terminé ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('complete-trip-' ~ trip.id) }}">
                        <button type="submit"
                                class="text-xs font-bold text-brand bg-lime hover:bg-lime/90 px-4 py-2 rounded-full transition flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                            Marquer comme terminé
                        </button>
                    </form>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Trajets terminés #}
        {% if completedTrips|length > 0 %}
        <div class="mb-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand/40 mb-3">Trajets terminés</p>
            <div class="space-y-2">
                {% for trip in completedTrips %}
                <div class="bg-white border border-black/6 rounded-xl px-5 py-3 flex items-center justify-between gap-4 opacity-70">
                    <div class="min-w-0">
                        <p class="font-semibold text-brand text-sm">{{ trip.departureCity }} → {{ trip.arrivalCity }}</p>
                        <p class="text-xs text-brand/40">{{ trip.departureAt|date('d/m/Y') }} · {{ trip.price }} €</p>
                    </div>
                    <span class="text-xs font-semibold text-brand/40 border border-brand/10 px-3 py-1 rounded-full">Terminé</span>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </div>
    {% endif %}

    {# ── SECTION PASSAGER ─────────────────────────────────────────────── #}
    {% set myBookings = bookings|default([]) %}
    {% set activeBookings    = myBookings|filter(b => b.status.value in ['pending','confirmed'] and b.trip.departureAt >= now) %}
    {% set pastBookings      = myBookings|filter(b => b.status.value == 'completed') %}
    {% set cancelledBookings = myBookings|filter(b => b.status.value == 'cancelled') %}

    {% if myBookings|length > 0 %}
    <div>
        <h2 class="text-lg font-extrabold text-brand mb-5 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7H4a2 2 0 00-2 2v9a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2zm-8-4v4M8 3v4m8-4v4"/>
            </svg>
            En tant que passager
        </h2>

        {# Réservations actives #}
        {% if activeBookings|length > 0 %}
        <div class="mb-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand/40 mb-3">Réservations en cours</p>
            <div class="space-y-3">
                {% for booking in activeBookings %}
                <div class="bg-white border border-black/8 rounded-2xl px-5 py-4 flex items-center justify-between gap-4 flex-wrap">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 mb-0.5">
                            {% if booking.status.value == 'confirmed' %}
                                <span class="w-2 h-2 rounded-full bg-lime shrink-0"></span>
                            {% else %}
                                <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
                            {% endif %}
                            <p class="font-semibold text-brand text-sm">
                                {{ booking.trip.departureCity }} → {{ booking.trip.arrivalCity }}
                            </p>
                        </div>
                        <p class="text-xs text-brand/50 ml-4">
                            {{ booking.trip.departureAt|date('d/m/Y à H:i') }}
                            · {{ booking.seats }} place{% if booking.seats > 1 %}s{% endif %}
                            · {{ booking.amount }} €
                        </p>
                        <p class="text-xs mt-0.5 ml-4">
                            Conducteur : <span class="font-semibold text-brand">{{ booking.trip.driver.firstName }} {{ booking.trip.driver.lastName|first }}.</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 shrink-0 flex-wrap">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full border
                            {% if booking.status.value == 'confirmed' %}bg-lime/15 text-brand border-lime/30
                            {% else %}bg-amber-50 text-amber-700 border-amber-200{% endif %}">
                            {{ booking.status.value == 'confirmed' ? 'Confirmé' : 'En attente' }}
                        </span>
                        <a href="{{ path('app_booking_show', {id: booking.id}) }}"
                           class="text-xs font-semibold text-brand border border-brand/15 bg-cream hover:bg-brand/8 px-3 py-1.5 rounded-full transition">Voir</a>
                        <form method="POST" action="{{ path('app_booking_cancel', {id: booking.id}) }}"
                              onsubmit="return confirm('Annuler cette réservation ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel-booking-' ~ booking.id) }}">
                            <button type="submit" class="text-xs font-semibold text-red-500 border border-red-200 bg-white hover:bg-red-50 px-3 py-1.5 rounded-full transition">Annuler</button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Réservations terminées — avec bouton "Laisser un avis" #}
        {% if pastBookings|length > 0 %}
        <div class="mb-5">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand/40 mb-3">Trajets effectués</p>
            <div class="space-y-2">
                {% for booking in pastBookings %}
                <div class="bg-white border border-black/6 rounded-xl px-5 py-3 flex items-center justify-between gap-4">
                    <div class="min-w-0">
                        <p class="font-semibold text-brand text-sm">
                            {{ booking.trip.departureCity }} → {{ booking.trip.arrivalCity }}
                        </p>
                        <p class="text-xs text-brand/40">{{ booking.trip.departureAt|date('d/m/Y') }} · {{ booking.amount }} €</p>
                    </div>
                    {% if booking.id in reviewedBookingIds %}
                        <span class="text-xs font-semibold text-brand/40 border border-brand/10 px-3 py-1 rounded-full flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                            Avis laissé
                        </span>
                    {% else %}
                        <a href="{{ path('app_review_create', {id: booking.id}) }}"
                           class="text-xs font-bold text-brand bg-lime hover:bg-lime/90 px-4 py-2 rounded-full transition shrink-0 flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                            </svg>
                            Laisser un avis
                        </a>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Annulées #}
        {% if cancelledBookings|length > 0 %}
        <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-brand/40 mb-3">Annulées</p>
            <div class="space-y-2">
                {% for booking in cancelledBookings %}
                <div class="bg-white border border-black/6 rounded-xl px-5 py-3 flex items-center justify-between gap-4 opacity-50">
                    <div class="min-w-0">
                        <p class="font-semibold text-brand text-sm">
                            {{ booking.trip.departureCity }} → {{ booking.trip.arrivalCity }}
                        </p>
                        <p class="text-xs text-brand/40">{{ booking.trip.departureAt|date('d/m/Y') }}</p>
                    </div>
                    <span class="text-xs font-semibold text-red-400 border border-red-100 px-3 py-1 rounded-full">Annulé</span>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    </div>
    {% endif %}

    {# Aucune activité #}
    {% if allDriverTrips|length == 0 and myBookings|length == 0 %}
    <div class="text-center py-16">
        <p class="text-brand/40 text-sm mb-4">Vous n'avez aucune activité pour le moment.</p>
        <a href="{{ path('app_trip_new') }}" class="bg-lime hover:bg-lime/90 text-brand font-bold px-6 py-3 rounded-xl text-sm transition">
            Proposer votre premier trajet →
        </a>
    </div>
    {% endif %}

</div>
{% endblock %}