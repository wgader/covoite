{% extends 'base.html.twig' %}

{% block title %}Mot de passe — Covoite{% endblock %}

{#
    Changer son mot de passe (PasswordController).
    Variables : passwordForm
#}
{% macro field(child, label, hint = null) %}
    <div>
        <label for="{{ child.vars.id }}" class="field-label">{{ label }}</label>
        <div class="relative">
            {{ form_widget(child, {attr: {class: 'field pr-12' ~ (child.vars.errors|length ? ' !border-red-400' : ''), 'data-password': ''}}) }}
            <button type="button" data-toggle-password aria-label="Afficher le mot de passe"
                    class="absolute inset-y-0 right-0 px-4 flex items-center text-brand/30 hover:text-brand/70 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        </div>
        {% for error in child.vars.errors %}
            <p class="text-xs font-medium text-red-600 mt-1.5">{{ error.message }}</p>
        {% endfor %}
        {% if hint %}<p class="text-xs text-brand/40 mt-1.5">{{ hint }}</p>{% endif %}
    </div>
{% endmacro %}

{% block body %}
<div class="max-w-md mx-auto px-4 sm:px-6 py-10 sm:py-14">

    <a href="{{ path('app_profile_me') }}" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand/50 hover:text-brand transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        Mon profil
    </a>

    <div class="mt-5 bg-white rounded-3xl shadow-card border border-black/5 p-6 sm:p-8">
        <span class="w-12 h-12 rounded-2xl bg-lime-soft text-brand flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        </span>
        <h1 class="text-2xl font-extrabold text-brand tracking-tight mt-4">Changer de mot de passe</h1>
        <p class="text-sm text-brand/50 mt-1">Par securite, on vous redemande d'abord votre mot de passe actuel.</p>

        {{ form_start(passwordForm, {attr: {class: 'mt-7 space-y-5', novalidate: 'novalidate'}}) }}

            {% for error in passwordForm.vars.errors %}
                <p class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm">{{ error.message }}</p>
            {% endfor %}

            {{ _self.field(passwordForm.currentPassword, 'Mot de passe actuel') }}
            <div class="h-px bg-black/5"></div>
            {{ _self.field(passwordForm.newPassword.first, 'Nouveau mot de passe', '8 caracteres minimum, avec une majuscule, une minuscule, un chiffre et un caractere special.') }}
            {{ _self.field(passwordForm.newPassword.second, 'Confirmer le nouveau mot de passe') }}
            {% for error in passwordForm.newPassword.vars.errors %}
                <p class="text-xs font-medium text-red-600 -mt-3">{{ error.message }}</p>
            {% endfor %}

            <button type="submit" class="w-full bg-lime hover:bg-lime-hover text-brand font-bold py-3.5 rounded-2xl text-sm transition">
                Enregistrer le nouveau mot de passe
            </button>
        {{ form_end(passwordForm) }}
    </div>
</div>

<script>
/* Bouton "oeil" : afficher / masquer le mot de passe */
document.querySelectorAll('[data-toggle-password]').forEach((btn) => btn.addEventListener('click', () => {
    const input = btn.parentElement.querySelector('[data-password]');
    input.type = input.type === 'password' ? 'text' : 'password';
    btn.classList.toggle('text-brand', input.type === 'text');
}));
</script>
{% endblock %}
