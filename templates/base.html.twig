<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Covoite{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Sora', 'sans-serif'] },
                    colors: {
                        brand:   { DEFAULT: '#0F2D24', light: '#1a4a3a' },
                        lime:    { DEFAULT: '#8DC63F', hover: '#7ab535' },
                        cream:   '#F5F5F0',
                        ink:     '#2C2C2C',
                    }
                }
            }
        }
    </script>
    {% block stylesheets %}{% endblock %}
</head>
<body class="font-sans bg-cream text-ink min-h-screen flex flex-col">

    {# NAVBAR #}
    <nav class="bg-cream border-b border-black/10 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

            {# LOGO #}
            <a href="{{ path('app_home') }}" class="flex items-center gap-1">
                <span class="text-2xl font-extrabold text-brand tracking-tight">Covoite</span>
                <span class="w-2 h-2 rounded-full bg-lime mb-3 -ml-1"></span>
            </a>

            {# NAV LINKS #}
            <div class="hidden md:flex items-center gap-8 text-sm font-medium text-brand/70">
                <a href="{{ path('app_home') }}" class="hover:text-brand transition">Accueil</a>
                <a href="{{ path('app_search') }}" class="hover:text-brand transition">Trajets</a>
                <a href="#" class="hover:text-brand transition">Comment ca marche</a>
                <a href="#" class="hover:text-brand transition">A propos</a>
            </div>

            {# AUTH #}
            <div class="flex items-center gap-3">
                {% if app.user %}
                    {% set unreadCount = unread_messages_count() %}

                    {# MESSAGES LINK #}
                    <a href="{{ path('app_messages') }}"
                       class="relative text-brand/70 hover:text-brand transition p-1.5 rounded-lg hover:bg-brand/5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        {% if unreadCount > 0 %}
                            <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-lime rounded-full flex items-center justify-center text-brand font-bold"
                                  style="font-size: 9px; line-height: 1;">
                                {{ unreadCount > 9 ? '9+' : unreadCount }}
                            </span>
                        {% endif %}
                    </a>

                    {# USER DROPDOWN #}
                    <div class="relative group">
                        <button class="text-sm font-semibold text-brand hover:text-brand/70 transition flex items-center gap-1.5">
                            {% if app.user.avatar %}
                                <img src="{{ app.user.avatar }}" alt="{{ app.user.firstName }}"
                                     class="w-7 h-7 rounded-full object-cover border border-brand/20">
                            {% else %}
                                <span class="w-7 h-7 rounded-full bg-brand flex items-center justify-center text-xs font-bold text-lime">
                                    {{ app.user.firstName|first|upper }}
                                </span>
                            {% endif %}
                            {{ app.user.firstName }}
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </button>

                        {# DROPDOWN MENU #}
                        <div class="absolute right-0 top-full mt-2 w-52 bg-white rounded-2xl shadow-lg border border-black/8 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150">

                            <a href="{{ path('app_account') }}"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-brand hover:bg-cream transition">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
                                    <rect x="3" y="3" width="7" height="7" rx="1"/>
                                    <rect x="14" y="3" width="7" height="7" rx="1"/>
                                    <rect x="3" y="14" width="7" height="7" rx="1"/>
                                    <rect x="14" y="14" width="7" height="7" rx="1"/>
                                </svg>
                                Tableau de bord
                            </a>

                            <a href="{{ path('app_profile_show', {'id': app.user.id}) }}"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-brand hover:bg-cream transition">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                Mon profil
                            </a>

                            <a href="{{ path('app_profile_edit') }}"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-brand hover:bg-cream transition">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Modifier le profil
                            </a>

                            <a href="{{ path('app_vehicle_index') }}"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-brand hover:bg-cream transition">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
                                    <rect x="1" y="3" width="15" height="13" rx="2"/>
                                    <path d="M16 8h4l3 3v4h-7V8z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                                Mes vehicules
                            </a>

                            <a href="{{ path('app_messages') }}"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-brand hover:bg-cream transition">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                </svg>
                                Messages
                                {% if unreadCount > 0 %}
                                    <span class="ml-auto bg-lime text-brand text-xs font-bold px-1.5 py-0.5 rounded-full">
                                        {{ unreadCount }}
                                    </span>
                                {% endif %}
                            </a>

                            <div class="border-t border-black/8 my-1.5"></div>

                            <a href="{{ path('app_logout') }}"
                               class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                                Deconnexion
                            </a>
                        </div>
                    </div>

                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="text-sm font-semibold bg-lime text-brand px-5 py-2 rounded-full hover:bg-lime-hover transition">
                        Se connecter
                    </a>
                    <a href="{{ path('app_register') }}"
                       class="text-sm font-semibold border-2 border-brand text-brand px-5 py-2 rounded-full hover:bg-brand hover:text-cream transition">
                        S'inscrire
                    </a>
                {% endif %}
            </div>
        </div>
    </nav>

    {# FLASH #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="max-w-7xl mx-auto px-6 mt-4">
                <div class="rounded-xl px-4 py-3 text-sm font-medium
                    {% if type == 'success' %}bg-lime/20 text-brand border border-lime/40
                    {% elseif type == 'error' %}bg-red-50 text-red-800 border border-red-200
                    {% else %}bg-brand/10 text-brand border border-brand/20{% endif %}">
                    {{ message }}
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-brand text-cream/60 mt-auto">
        <div class="max-w-7xl mx-auto px-6 py-8 flex justify-between items-center text-sm">
            <div class="flex items-center gap-1">
                <span class="font-bold text-cream text-lg">Covoite</span>
                <span class="w-1.5 h-1.5 rounded-full bg-lime mb-2.5 -ml-0.5"></span>
            </div>
            <div class="flex gap-6">
                <a href="#" class="hover:text-cream transition">CGU</a>
                <a href="#" class="hover:text-cream transition">Confidentialite</a>
                <a href="#" class="hover:text-cream transition">Contact</a>
            </div>
            <span>© 2026 Covoite</span>
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>