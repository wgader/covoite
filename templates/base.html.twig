<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Covoite — Le covoiturage, plus proche de vous{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Covoite met en relation des personnes qui vont dans la meme direction. Un trajet plus simple, plus economique et plus humain.{% endblock %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Sora', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: { DEFAULT: '#0F2D24', light: '#1a4a3a' },
                        lime:  { DEFAULT: '#8DC63F', hover: '#7ab535', soft: '#EEF6E2' },
                        cream: '#F5F5F0',
                        ink:   '#2C2C2C',
                    },
                    boxShadow: {
                        card: '0 1px 2px rgba(15,45,36,.04), 0 8px 24px -12px rgba(15,45,36,.12)',
                        pop:  '0 24px 60px -20px rgba(15,45,36,.35)',
                    },
                }
            }
        }
    </script>
    <style>
        [x-cloak], [hidden] { display: none !important; }
        body { -webkit-font-smoothing: antialiased; }
        /* Animations des modales et des toasts */
        @keyframes modal-in   { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
        @keyframes fade-in    { from { opacity: 0; } to { opacity: 1; } }
        @keyframes toast-in   { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
        .anim-modal  { animation: modal-in .18s ease-out; }
        .anim-fade   { animation: fade-in .18s ease-out; }
        .anim-toast  { animation: toast-in .2s ease-out; }
        /* Champs de formulaire communs (utilisables partout via la classe .field) */
        .field { width: 100%; background: #fff; border: 1px solid rgba(15,45,36,.12); border-radius: .875rem; padding: .75rem 1rem; font-size: .875rem; color: #0F2D24; outline: none; transition: border-color .15s, box-shadow .15s; }
        .field::placeholder { color: rgba(15,45,36,.35); }
        .field:focus { border-color: #8DC63F; box-shadow: 0 0 0 4px rgba(141,198,63,.18); }
        .field-label { display: block; font-size: .75rem; font-weight: 600; color: rgba(15,45,36,.6); margin-bottom: .375rem; }
        .form-error ul { margin-top: .375rem; font-size: .75rem; color: #dc2626; }
        /* Cartes Leaflet (Symfony UX Map) : Tailwind force "max-width: 100%" sur les images,
           ce qui casse les tuiles de la carte. On l'annule a l'interieur des cartes. */
        .leaflet-container { font-family: 'Sora', sans-serif; }
        .leaflet-container img { max-width: none !important; max-height: none !important; }
        .leaflet-popup-content-wrapper { border-radius: 1rem; box-shadow: 0 24px 60px -20px rgba(15,45,36,.35); }
        .leaflet-popup-content { margin: .75rem 1rem; font-size: .8125rem; color: #0F2D24; }
        .leaflet-bar a { color: #0F2D24; }
    </style>
    {% block stylesheets %}{% endblock %}
    {# Autocompletion des lieux (window.Places, voir assets/places.js). Script classique, donc
       disponible tout de suite pour les scripts des pages (barre de recherche, assistant...). #}
    <script src="{{ asset('places.js') }}"
            data-search-url="{{ path('api_places') }}"
            data-reverse-url="{{ path('api_places_reverse') }}"
            data-position-url="{{ path('api_places_position') }}"></script>
    {# Calendrier maison (window.DatePicker, voir assets/datepicker.js) #}
    <script src="{{ asset('datepicker.js') }}"></script>
    {# JavaScript gere par AssetMapper (Stimulus + Symfony UX Map). Les modules sont charges en differe. #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body class="font-sans bg-cream text-ink min-h-screen flex flex-col">

{% set unreadCount = app.user ? unread_messages_count() : 0 %}
{% set notifCount  = app.user ? unread_notifications_count() : 0 %}
{% set currentRoute = app.request.attributes.get('_route') %}

{# ══════════════════════════ NAVBAR ══════════════════════════ #}
<header class="bg-white/90 backdrop-blur border-b border-black/5 sticky top-0 z-40">
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">

        {# LOGO #}
        <a href="{{ path('app_home') }}" class="flex items-center gap-1 shrink-0" aria-label="Accueil Covoite">
            <span class="text-2xl font-extrabold text-brand tracking-tight">Covoite</span>
            <span class="w-2 h-2 rounded-full bg-lime mb-3 -ml-0.5"></span>
        </a>

        {# ACTIONS #}
        <div class="flex items-center gap-1 sm:gap-2">

            <a href="{{ path('app_search') }}"
               class="hidden md:inline-flex items-center gap-2 text-sm font-semibold px-3 py-2 rounded-full transition
                      {{ currentRoute == 'app_search' ? 'text-brand bg-cream' : 'text-brand/70 hover:text-brand hover:bg-cream' }}">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
                Rechercher
            </a>

            <a href="{{ path('app_trip_new') }}"
               class="hidden md:inline-flex items-center gap-2 text-sm font-semibold text-brand border border-brand/15 hover:border-brand/40 px-4 py-2 rounded-full transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8" stroke-linecap="round"/></svg>
                Proposer un trajet
            </a>

            {% if app.user %}
                <a href="{{ path('app_rides') }}"
                   class="hidden md:inline-flex items-center text-sm font-semibold px-3 py-2 rounded-full transition
                          {{ currentRoute starts with 'app_ride' ? 'text-brand bg-cream' : 'text-brand/70 hover:text-brand hover:bg-cream' }}">
                    Mes trajets
                </a>

                {# NOTIFICATIONS (le badge est mis a jour en direct, voir le script "Temps reel" plus bas) #}
                <a href="{{ path('app_notifications') }}" aria-label="Notifications"
                   class="relative w-10 h-10 inline-flex items-center justify-center rounded-full transition
                          {{ currentRoute == 'app_notifications' ? 'text-brand bg-cream' : 'text-brand/70 hover:text-brand hover:bg-cream' }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/>
                    </svg>
                    <span data-live-badge="notifications" {{ notifCount > 0 ? '' : 'hidden' }}
                          class="absolute top-1 right-1 min-w-[18px] h-[18px] px-1 bg-lime text-brand rounded-full flex items-center justify-center font-bold text-[10px] ring-2 ring-white">{{ notifCount > 9 ? '9+' : notifCount }}</span>
                </a>

                {# MESSAGES #}
                <a href="{{ path('app_messages') }}" aria-label="Messages"
                   class="relative w-10 h-10 inline-flex items-center justify-center rounded-full text-brand/70 hover:text-brand hover:bg-cream transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <span data-live-badge="messages" {{ unreadCount > 0 ? '' : 'hidden' }}
                          class="absolute top-1 right-1 min-w-[18px] h-[18px] px-1 bg-lime text-brand rounded-full flex items-center justify-center font-bold text-[10px] ring-2 ring-white">{{ unreadCount > 9 ? '9+' : unreadCount }}</span>
                </a>

                {# MENU UTILISATEUR (clic, pas survol : fonctionne aussi sur mobile) #}
                <div class="relative" data-dropdown>
                    <button type="button" data-dropdown-toggle aria-haspopup="true" aria-expanded="false"
                            class="flex items-center gap-1.5 pl-1 pr-2 py-1 rounded-full hover:bg-cream transition">
                        {% if app.user.avatar %}
                            <img src="{{ app.user.avatar }}" alt="" class="w-8 h-8 rounded-full object-cover">
                        {% else %}
                            <span class="w-8 h-8 rounded-full bg-brand flex items-center justify-center text-xs font-bold text-lime">
                                {{ app.user.firstName|first|upper }}
                            </span>
                        {% endif %}
                        <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>

                    <div data-dropdown-menu hidden
                         class="anim-fade absolute right-0 top-full mt-2 w-64 bg-white rounded-2xl shadow-pop border border-black/5 p-2">

                        <a href="{{ path('app_profile_show', {id: app.user.id}) }}"
                           class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-cream transition">
                            {% if app.user.avatar %}
                                <img src="{{ app.user.avatar }}" alt="" class="w-10 h-10 rounded-full object-cover">
                            {% else %}
                                <span class="w-10 h-10 rounded-full bg-brand flex items-center justify-center text-sm font-bold text-lime">
                                    {{ app.user.firstName|first|upper }}
                                </span>
                            {% endif %}
                            <span class="min-w-0">
                                <span class="block text-sm font-bold text-brand truncate">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                                <span class="block text-xs text-brand/50">Voir et modifier mon profil</span>
                            </span>
                        </a>

                        <div class="h-px bg-black/5 my-1.5"></div>

                        {# Liens visibles seulement sur mobile (sur ordinateur ils sont dans la barre) #}
                        <a href="{{ path('app_search') }}" class="md:hidden flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
                            Rechercher un trajet
                        </a>
                        <a href="{{ path('app_trip_new') }}" class="md:hidden flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8" stroke-linecap="round"/></svg>
                            Proposer un trajet
                        </a>

                        <a href="{{ path('app_rides') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6H15a3 3 0 0 1 0 6H9a3 3 0 0 0 0 6h6.5"/></svg>
                            Mes trajets
                        </a>
                        <a href="{{ path('app_notifications') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
                            Notifications
                            {% if notifCount > 0 %}
                                <span class="ml-auto bg-lime text-brand text-[11px] font-bold px-2 py-0.5 rounded-full">{{ notifCount }}</span>
                            {% endif %}
                        </a>
                        <a href="{{ path('app_messages') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Messages
                            {% if unreadCount > 0 %}
                                <span class="ml-auto bg-lime text-brand text-[11px] font-bold px-2 py-0.5 rounded-full">{{ unreadCount }}</span>
                            {% endif %}
                        </a>
                        <a href="{{ path('app_vehicle_index') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 17h14M5 17a2 2 0 1 0 4 0M15 17a2 2 0 1 0 4 0M3 17v-4l2-5a2 2 0 0 1 1.9-1.4h10.2A2 2 0 0 1 19 8l2 5v4"/></svg>
                            Mes vehicules
                        </a>
                        <a href="{{ path('app_password') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                            <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                            Mot de passe
                        </a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-brand rounded-xl hover:bg-cream transition">
                                <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"/></svg>
                                Administration
                            </a>
                        {% endif %}

                        <div class="h-px bg-black/5 my-1.5"></div>

                        {# Deconnexion par formulaire POST + jeton CSRF : un autre site ne peut pas nous deconnecter
                           a notre insu (avec un simple lien <img src="/deconnexion">, c'etait possible) #}
                        <form action="{{ path('app_logout') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 text-sm font-medium text-red-600 rounded-xl hover:bg-red-50 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                                Se deconnecter
                            </button>
                        </form>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}"
                   class="text-sm font-semibold text-brand px-3 py-2 rounded-full hover:bg-cream transition">
                    Connexion
                </a>
                <a href="{{ path('app_register') }}"
                   class="text-sm font-semibold bg-brand text-cream px-4 py-2 rounded-full hover:bg-brand-light transition">
                    S'inscrire
                </a>
            {% endif %}
        </div>
    </nav>
</header>

{# ══════════════════════════ NOTIFICATIONS (toasts) ══════════════════════════ #}
<div id="toasts" class="fixed top-20 right-4 left-4 sm:left-auto sm:w-96 z-50 flex flex-col gap-2 pointer-events-none">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div data-toast role="status"
                 class="anim-toast pointer-events-auto flex items-start gap-3 bg-white rounded-2xl shadow-pop border border-black/5 p-4">
                {% if type == 'success' %}
                    <span class="w-8 h-8 rounded-full bg-lime/20 text-brand flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                {% elseif type == 'error' %}
                    <span class="w-8 h-8 rounded-full bg-red-100 text-red-600 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M12 8v5M12 16.5v.5" stroke-linecap="round"/></svg>
                    </span>
                {% else %}
                    <span class="w-8 h-8 rounded-full bg-brand/10 text-brand flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M12 11v5M12 7.5V8" stroke-linecap="round"/></svg>
                    </span>
                {% endif %}
                <p class="text-sm text-brand font-medium leading-snug pt-1.5 flex-1">{{ message }}</p>
                <button type="button" data-toast-close aria-label="Fermer" class="text-brand/30 hover:text-brand transition pt-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"/></svg>
                </button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<main class="flex-1">
    {% block body %}{% endblock %}
</main>

{% block footer %}
{# ══════════════════════════ FOOTER ══════════════════════════ #}
<footer class="bg-brand text-cream/60 mt-auto">
    <div class="max-w-6xl mx-auto px-6 py-12 grid gap-10 md:grid-cols-4">
        <div class="md:col-span-2">
            <div class="flex items-center gap-1 mb-3">
                <span class="font-extrabold text-cream text-2xl tracking-tight">Covoite</span>
                <span class="w-2 h-2 rounded-full bg-lime mb-3 -ml-0.5"></span>
            </div>
            <p class="text-sm leading-relaxed max-w-xs">Le covoiturage, plus proche de vous. Partagez la route, les frais et quelques bons moments.</p>
        </div>
        <div>
            <p class="text-cream font-semibold text-sm mb-3">Voyager</p>
            <ul class="space-y-2 text-sm">
                <li><a href="{{ path('app_search') }}" class="hover:text-cream transition">Rechercher un trajet</a></li>
                <li><a href="{{ path('app_trip_new') }}" class="hover:text-cream transition">Proposer un trajet</a></li>
                <li><a href="{{ path('app_home') }}#comment-ca-marche" class="hover:text-cream transition">Comment ca marche</a></li>
            </ul>
        </div>
        <div>
            <p class="text-cream font-semibold text-sm mb-3">Covoite</p>
            <ul class="space-y-2 text-sm">
                <li><a href="#" class="hover:text-cream transition">Conditions d'utilisation</a></li>
                <li><a href="#" class="hover:text-cream transition">Confidentialite</a></li>
                <li><a href="#" class="hover:text-cream transition">Contact</a></li>
            </ul>
        </div>
    </div>
    <div class="border-t border-cream/10">
        <p class="max-w-6xl mx-auto px-6 py-5 text-xs">&copy; {{ 'now'|date('Y') }} Covoite. Projet BUT MMI.</p>
    </div>
</footer>
{% endblock %}

{# ══════════════════════════ MODALE DE CONFIRMATION (remplace confirm()) ══════════════════════════
   Utilisation sur n'importe quel formulaire :
     <form method="post" action="..."
           data-confirm="Texte d'explication"
           data-confirm-title="Annuler ce trajet ?"
           data-confirm-button="Oui, annuler"
           data-confirm-tone="danger"                  (optionnel : rouge)
           data-confirm-reason="Motif (optionnel)">    (optionnel : ajoute un champ texte envoye en "reason")
#}
<div id="confirm-modal" hidden class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <div data-modal-backdrop class="anim-fade absolute inset-0 bg-brand/40 backdrop-blur-sm"></div>
    <div class="anim-modal relative w-full max-w-md bg-white rounded-3xl shadow-pop p-6 sm:p-7">
        <div data-confirm-icon class="w-12 h-12 rounded-2xl flex items-center justify-center mb-4"></div>
        <h2 id="confirm-title" class="text-lg font-extrabold text-brand"></h2>
        <p data-confirm-text class="text-sm text-brand/60 mt-1.5 leading-relaxed"></p>
        <div data-confirm-reason-wrap hidden class="mt-4">
            <label for="confirm-reason" class="field-label" data-confirm-reason-label></label>
            <textarea id="confirm-reason" rows="3" class="field resize-none"></textarea>
        </div>
        <div class="flex flex-col-reverse sm:flex-row gap-2 mt-6">
            <button type="button" data-modal-close
                    class="flex-1 px-5 py-3 rounded-full border border-brand/15 text-brand font-semibold text-sm hover:bg-cream transition">
                Retour
            </button>
            <button type="button" data-confirm-ok
                    class="flex-1 px-5 py-3 rounded-full font-semibold text-sm transition"></button>
        </div>
    </div>
</div>

<script>
(() => {
    // ── Menus deroulants ouverts au clic ───────────────────────────────
    document.querySelectorAll('[data-dropdown]').forEach((root) => {
        const btn  = root.querySelector('[data-dropdown-toggle]');
        const menu = root.querySelector('[data-dropdown-menu]');
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            menu.hidden = !menu.hidden;
            btn.setAttribute('aria-expanded', String(!menu.hidden));
        });
        document.addEventListener('click', (e) => {
            if (!root.contains(e.target)) { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
        });
    });

    // ── Toasts : fermeture auto apres 5 s ──────────────────────────────
    document.querySelectorAll('[data-toast]').forEach((toast) => {
        const close = () => toast.remove();
        toast.querySelector('[data-toast-close]').addEventListener('click', close);
        setTimeout(close, 5000);
    });

    // ── Modales generiques : <button data-modal-open="mon-id"> + <div id="mon-id" data-modal hidden> ──
    let lastFocus = null;
    const openModal = (modal) => {
        lastFocus = document.activeElement;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        const focusable = modal.querySelector('input, textarea, select, button:not([data-modal-close])');
        if (focusable) setTimeout(() => focusable.focus(), 50);
    };
    const closeModal = (modal) => {
        modal.hidden = true;
        document.body.style.overflow = '';
        if (lastFocus) lastFocus.focus();
    };
    window.CovoiteModal = { open: openModal, close: closeModal };

    document.addEventListener('click', (e) => {
        const opener = e.target.closest('[data-modal-open]');
        if (opener) {
            const modal = document.getElementById(opener.dataset.modalOpen);
            if (modal) { e.preventDefault(); openModal(modal); }
            return;
        }
        if (e.target.closest('[data-modal-close]') || e.target.matches('[data-modal-backdrop]')) {
            const modal = e.target.closest('[role="dialog"]');
            if (modal) closeModal(modal);
        }
    });
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('[role="dialog"]:not([hidden])').forEach(closeModal);
    });

    // ── Confirmation des formulaires sensibles ─────────────────────────
    const modal   = document.getElementById('confirm-modal');
    const okBtn   = modal.querySelector('[data-confirm-ok]');
    const icon    = modal.querySelector('[data-confirm-icon]');
    const reasonW = modal.querySelector('[data-confirm-reason-wrap]');
    const reason  = modal.querySelector('#confirm-reason');
    let pendingForm = null;

    const ICONS = {
        danger:  '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>',
        default: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01" stroke-linecap="round"/></svg>',
    };

    document.addEventListener('submit', (e) => {
        const form = e.target;
        if (!form.matches('[data-confirm]') || form.dataset.confirmed === '1') return;
        e.preventDefault();
        pendingForm = form;

        const danger = form.dataset.confirmTone === 'danger';
        modal.querySelector('#confirm-title').textContent       = form.dataset.confirmTitle || 'Confirmer ?';
        modal.querySelector('[data-confirm-text]').textContent  = form.dataset.confirm || '';
        okBtn.textContent = form.dataset.confirmButton || 'Confirmer';
        okBtn.className   = 'flex-1 px-5 py-3 rounded-full font-semibold text-sm transition ' +
            (danger ? 'bg-red-600 text-white hover:bg-red-700' : 'bg-lime text-brand hover:bg-lime-hover');
        icon.className    = 'w-12 h-12 rounded-2xl flex items-center justify-center mb-4 ' +
            (danger ? 'bg-red-50 text-red-600' : 'bg-lime/20 text-brand');
        icon.innerHTML    = danger ? ICONS.danger : ICONS.default;

        reason.value   = '';
        reasonW.hidden = !form.dataset.confirmReason;
        modal.querySelector('[data-confirm-reason-label]').textContent = form.dataset.confirmReason || '';

        openModal(modal);
    });

    okBtn.addEventListener('click', () => {
        if (!pendingForm) return;
        if (pendingForm.dataset.confirmReason) {
            let input = pendingForm.querySelector('input[name="reason"]');
            if (!input) {
                input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'reason';
                pendingForm.appendChild(input);
            }
            input.value = reason.value.trim();
        }
        pendingForm.dataset.confirmed = '1';
        okBtn.disabled = true;
        pendingForm.submit();
    });
})();
</script>

<script>
/* ── Barres de recherche : autocompletion depart / arrivee ───────────────
   Chaque bloc [data-place] contient le champ visible (data-place-input), la liste
   (data-place-list) et 3 champs caches remplis au choix d'un lieu : sa ville, sa
   latitude et sa longitude. Les trajets sont cherches par VILLE : taper
   "Leclerc Corgnac" trouve donc les trajets qui partent de Limoges.
   Le moteur (appel a /api/lieux, tri par proximite, affichage) est dans assets/places.js. */
(() => {
    document.querySelectorAll('[data-place]').forEach((box) => {
        const input = box.querySelector('[data-place-input]');
        const city  = box.querySelector('[data-place-city]');
        const lat   = box.querySelector('[data-place-lat]');
        const lng   = box.querySelector('[data-place-lng]');

        Places.attach(input, box.querySelector('[data-place-list]'), {
            mode: box.dataset.place || 'tout',
            onPick: (p) => { city.value = p.city; lat.value = p.lat; lng.value = p.lng; },
            onType: () => { city.value = ''; lat.value = ''; lng.value = ''; }, // le texte a change : l'ancien choix ne compte plus
        });
    });

    // Champ "Date" : calendrier maison dans une bulle (assets/datepicker.js)
    document.querySelectorAll('[data-datepicker]').forEach((box) => DatePicker.popover(box, { allowClear: true }));

    document.querySelectorAll('[data-search-form]').forEach((form) => {
        // Bouton "inverser depart / arrivee" : on echange le texte ET les champs caches
        const swap = form.querySelector('[data-swap]');
        if (swap) swap.addEventListener('click', () => {
            const [a, b] = [...form.querySelectorAll('[data-place]')].map((box) => [...box.querySelectorAll('input')]);
            a.forEach((input, i) => { [input.value, b[i].value] = [b[i].value, input.value]; });
            swap.animate([{ transform: 'rotate(0)' }, { transform: 'rotate(180deg)' }], { duration: 250 });
        });

        // Champs caches vides = pas envoyes (URL plus propre : pas de "&fromCity=&fromLat=")
        form.addEventListener('submit', () => {
            form.querySelectorAll('input[type="hidden"]').forEach((h) => { h.disabled = h.value === ''; });
        });
        // Retour arriere du navigateur : on reactive les champs desactives a l'envoi
        window.addEventListener('pageshow', () => form.querySelectorAll('input[type="hidden"]').forEach((h) => { h.disabled = false; }));
    });
})();
</script>

{% if app.user %}
{# ══════════ TEMPS REEL (Mercure) ══════════
   mercure() renvoie l'adresse du hub ET pose un cookie qui autorise CE navigateur a ecouter
   UNIQUEMENT le sujet prive de l'utilisateur connecte (voir App\Service\LivePublisher). #}
<script data-live-url="{{ mercure(live_topic(app.user), {subscribe: live_topic(app.user)}) }}">
(() => {
    const url = document.currentScript.dataset.liveUrl;
    if (!url || !window.EventSource) return;

    const setBadge = (name, count) => document.querySelectorAll('[data-live-badge="' + name + '"]').forEach((b) => {
        b.hidden = !(count > 0);
        b.textContent = count > 9 ? '9+' : String(count);
    });

    // Petite bulle en haut a droite (meme style que les messages flash)
    const toast = (title, text) => {
        const box = document.getElementById('toasts');
        if (!box) return;
        const t = document.createElement('div');
        t.setAttribute('role', 'status');
        t.className = 'anim-toast pointer-events-auto flex items-start gap-3 bg-white rounded-2xl shadow-pop border border-black/5 p-4';
        t.innerHTML = '<span class="w-8 h-8 rounded-full bg-lime/20 text-brand flex items-center justify-center shrink-0">'
            + '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg></span>'
            + '<a href="{{ path('app_notifications') }}" class="flex-1 pt-0.5"><p class="text-sm font-bold text-brand"></p><p class="text-xs text-brand/60 leading-snug mt-0.5"></p></a>';
        const [p1, p2] = t.querySelectorAll('p');
        p1.textContent = title;   // textContent : le texte n'est jamais interprete comme du HTML
        p2.textContent = text;
        box.appendChild(t);
        setTimeout(() => t.remove(), 7000);
    };

    let source = null, retry = 1000;
    const connect = () => {
        source = new EventSource(url, { withCredentials: true });
        source.onopen = () => { retry = 1000; window.covoiteLive = true; };
        source.onmessage = (e) => {
            let data;
            try { data = JSON.parse(e.data); } catch (err) { return; }
            if (data.type === 'notification') {
                setBadge('notifications', data.unread);
                toast(data.title, data.text);
            }
            if (data.type === 'message' && typeof data.unread === 'number') {
                setBadge('messages', data.unread);
            }
            // Les pages interessees (ex : la discussion ouverte) ecoutent cet evenement
            window.dispatchEvent(new CustomEvent('covoite:live', { detail: data }));
        };
        source.onerror = () => {
            window.covoiteLive = false;
            source.close();
            setTimeout(connect, retry);
            retry = Math.min(retry * 2, 60000); // on reessaie de plus en plus lentement
        };
    };
    connect();
})();
</script>
{% endif %}

