{% extends 'base.html.twig' %}

{% block title %}Connexion — Covoite{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex items-center justify-center px-6 py-12">
    <div class="w-full max-w-md">

        {# Logo / titre #}
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-brand mb-2">Bon retour !</h1>
            <p class="text-brand/50 text-sm">Connectez-vous pour accéder à vos trajets</p>
        </div>

        {# Déjà connecté #}
        {% if app.user %}
            <div class="bg-lime/10 border border-lime/30 text-brand rounded-xl p-4 mb-6 text-sm text-center">
                Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.
                <a href="{{ logout_path() }}" class="underline font-semibold ml-1">Se déconnecter</a>
            </div>
        {% endif %}

        {# Erreur de connexion #}
        {% if error %}
            <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 mb-6 text-sm flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {# Formulaire — les noms _username, _password, _csrf_token sont obligatoires pour Symfony Security #}
        <form method="post" class="bg-white rounded-2xl border border-black/8 p-8 shadow-sm">

            {# Email #}
            <div class="mb-5">
                <label for="username" class="block text-sm font-semibold text-brand mb-2">
                    Adresse e-mail
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="w-4 h-4 text-brand/30" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <input
                        type="email"
                        id="username"
                        name="_username"
                        value="{{ last_username }}"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="vous@exemple.fr"
                        class="w-full pl-11 pr-4 py-3 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition"
                    >
                </div>
            </div>

            {# Mot de passe #}
            <div class="mb-6">
                <label for="password" class="block text-sm font-semibold text-brand mb-2">
                    Mot de passe
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <svg class="w-4 h-4 text-brand/30" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    </div>
                    <input
                        type="password"
                        id="password"
                        name="_password"
                        autocomplete="current-password"
                        required
                        placeholder="••••••••"
                        class="w-full pl-11 pr-4 py-3 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition"
                    >
                </div>
            </div>

            {# Token CSRF — obligatoire, ne pas supprimer #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            {# Bouton #}
            <button type="submit"
                    class="w-full bg-lime hover:bg-lime/90 text-brand font-bold py-3.5 rounded-xl transition text-sm flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
                Se connecter
            </button>

        </form>

        {# Lien inscription #}
        <p class="text-center text-sm text-brand/50 mt-6">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-brand font-semibold hover:underline">
                S'inscrire gratuitement
            </a>
        </p>

    </div>
</div>
{% endblock %}