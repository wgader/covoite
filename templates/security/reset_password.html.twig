{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Covoite{% endblock %}

{# Variables : form (ResetPasswordFormType), firstName #}
{% block body %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-card border border-black/5 p-6 sm:p-8">
        <span class="w-12 h-12 rounded-2xl bg-lime-soft text-brand flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        </span>
        <h1 class="text-2xl font-extrabold text-brand tracking-tight mt-4">Nouveau mot de passe</h1>
        <p class="text-sm text-brand/50 mt-1">{{ firstName }}, choisissez votre nouveau mot de passe.</p>

        {{ form_start(form, {attr: {class: 'mt-7 space-y-5', novalidate: 'novalidate'}}) }}
            {% for errors in [form.vars.errors, form.newPassword.vars.errors] %}
                {% for error in errors %}
                    <p class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm">{{ error.message }}</p>
                {% endfor %}
            {% endfor %}
            {% for child, label in {first: 'Nouveau mot de passe', second: 'Confirmer le mot de passe'} %}
                {% set field = form.newPassword[child] %}
                <div>
                    <label for="{{ field.vars.id }}" class="field-label">{{ label }}</label>
                    {{ form_widget(field, {attr: {class: 'field' ~ (field.vars.errors|length ? ' !border-red-400' : '')}}) }}
                    {% for error in field.vars.errors %}<p class="text-xs font-medium text-red-600 mt-1.5">{{ error.message }}</p>{% endfor %}
                    {% if child == 'first' %}<p class="text-xs text-brand/40 mt-1.5">8 caracteres minimum, avec une majuscule, une minuscule, un chiffre et un caractere special.</p>{% endif %}
                </div>
            {% endfor %}
            <button type="submit" class="w-full bg-lime hover:bg-lime-hover text-brand font-bold py-3.5 rounded-2xl text-sm transition">
                Enregistrer
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
