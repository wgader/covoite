{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie — Covoite{% endblock %}

{# Variables : form (ForgotPasswordFormType) #}
{% block body %}
<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-3xl shadow-card border border-black/5 p-6 sm:p-8">
            <span class="w-12 h-12 rounded-2xl bg-lime-soft text-brand flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <h1 class="text-2xl font-extrabold text-brand tracking-tight mt-4">Mot de passe oublie ?</h1>
            <p class="text-sm text-brand/50 mt-1">Indiquez l'adresse de votre compte : on vous envoie un lien pour en choisir un nouveau.</p>

            {{ form_start(form, {attr: {class: 'mt-7 space-y-5', novalidate: 'novalidate'}}) }}
                {% for error in form.vars.errors %}
                    <p class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm">{{ error.message }}</p>
                {% endfor %}
                <div>
                    <label for="{{ form.email.vars.id }}" class="field-label">Adresse e-mail</label>
                    {{ form_widget(form.email, {attr: {class: 'field' ~ (form.email.vars.errors|length ? ' !border-red-400' : ''), autofocus: true}}) }}
                    {% for error in form.email.vars.errors %}<p class="text-xs font-medium text-red-600 mt-1.5">{{ error.message }}</p>{% endfor %}
                </div>
                <button type="submit" class="w-full bg-lime hover:bg-lime-hover text-brand font-bold py-3.5 rounded-2xl text-sm transition">
                    Recevoir le lien
                </button>
            {{ form_end(form) }}
        </div>
        <p class="text-center text-sm text-brand/50 mt-6">
            <a href="{{ path('app_login') }}" class="text-brand font-semibold hover:underline">Retour a la connexion</a>
        </p>
    </div>
</div>
{% endblock %}
