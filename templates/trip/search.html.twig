{% extends 'base.html.twig' %}

{% block title %}{{ from ?: 'Tous les departs' }} → {{ to ?: 'toutes destinations' }} — Covoite{% endblock %}

{% block body %}
{% set params = {from: from, to: to, date: date, seats: seats} %}

{# ══════════ BARRE DE RECHERCHE ══════════ #}
<div class="bg-white/80 backdrop-blur border-b border-black/5 relative md:sticky md:top-16 z-30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4">
        {% include 'trip/_search_form.html.twig' with {from: from, to: to, date: date, seats: seats, size: 'md'} %}
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-10">

    {# ══════════ EN-TETE DES RESULTATS ══════════ #}
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-brand tracking-tight flex flex-wrap items-center gap-x-2">
                {% if from or to %}
                    <span>{{ from ?: 'Partout' }}</span>
                    <svg class="w-6 h-6 text-lime" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{{ to ?: 'Partout' }}</span>
                {% else %}
                    Tous les trajets
                {% endif %}
            </h1>
            <p class="text-sm text-brand/50 mt-1.5">
                {{ total }} trajet{{ total > 1 ? 's' }} disponible{{ total > 1 ? 's' }}
                {%- if date %} le {{ date(date)|date_fr('long') }}{% endif %}
                {%- if seats > 1 %} · {{ seats }} passagers{% endif %}
            </p>
        </div>

        {% if total > 1 %}
            <div class="flex gap-2" role="group" aria-label="Trier les resultats">
                {% for key, label in {depart: 'Depart le plus tot', prix: 'Prix le plus bas'} %}
                    <a href="{{ path('app_search', params|merge({tri: key})) }}"
                       class="text-sm font-semibold px-4 py-2 rounded-full border transition
                              {{ sort == key ? 'bg-brand text-cream border-brand' : 'bg-white text-brand border-black/10 hover:border-brand/30' }}">
                        {{ label }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ══════════ RESULTATS ══════════ #}
    {% if trips is empty %}
        <div class="bg-white rounded-3xl border border-black/5 shadow-card px-6 py-14 text-center mt-8">
            <div class="w-16 h-16 rounded-2xl bg-lime-soft text-brand mx-auto flex items-center justify-center">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </div>
            <h2 class="text-xl font-extrabold text-brand mt-5">Aucun trajet pour l'instant</h2>
            <p class="text-sm text-brand/50 mt-1.5 max-w-sm mx-auto">
                {% if date %}Essayez sans date, ou un autre jour : de nouveaux trajets sont publies chaque jour.{% else %}Personne ne fait encore ce trajet. Et si c'etait vous ?{% endif %}
            </p>
            <div class="flex flex-col sm:flex-row gap-2 justify-center mt-6">
                {% if date %}
                    <a href="{{ path('app_search', params|merge({date: ''})) }}" class="bg-lime hover:bg-lime-hover text-brand font-semibold text-sm px-6 py-3 rounded-full transition">Voir toutes les dates</a>
                {% endif %}
                <a href="{{ path('app_trip_new') }}" class="bg-white border border-brand/15 hover:border-brand/40 text-brand font-semibold text-sm px-6 py-3 rounded-full transition">Proposer ce trajet</a>
            </div>
        </div>
    {% else %}
        <div class="mt-6">
            {% set currentDay = null %}
            {% for trip in trips %}
                {% set day = trip.departureAt|date('Y-m-d') %}

                {# Separateur par jour (seulement quand on trie par date) #}
                {% if sort == 'depart' and day != currentDay %}
                    {% set currentDay = day %}
                    <h2 class="text-sm font-bold text-brand/60 mt-8 first:mt-2 mb-3 first-letter:uppercase">
                        {% if day == 'now'|date('Y-m-d') %}Aujourd'hui{% elseif day == '+1 day'|date('Y-m-d') %}Demain{% else %}{{ trip.departureAt|date_fr('long') }}{% endif %}
                    </h2>
                {% endif %}

                {% set driver = trip.driver %}
                {% set rating = ratings[driver.id] ?? null %}

                <a href="{{ path('app_trip_show', {id: trip.id}) }}"
                   class="group block bg-white rounded-3xl border border-black/5 shadow-card hover:shadow-pop hover:-translate-y-0.5 transition mb-3 overflow-hidden">

                    <div class="flex gap-4 p-5 sm:p-6">
                        {# Horaire + itineraire #}
                        <div class="flex gap-3 sm:gap-4 flex-1 min-w-0">
                            <div class="flex flex-col justify-between w-12 shrink-0 py-0.5">
                                <span class="text-base font-extrabold text-brand">{{ trip.departureAt|date('H:i') }}</span>
                                {% if sort == 'prix' %}<span class="text-[11px] text-brand/40 first-letter:uppercase">{{ trip.departureAt|date_fr }}</span>{% endif %}
                            </div>
                            <div class="flex flex-col items-center pt-2 pb-1.5">
                                <span class="w-3 h-3 rounded-full border-[2.5px] border-brand bg-white"></span>
                                <span class="w-0.5 flex-1 bg-brand my-1 min-h-[28px]"></span>
                                <span class="w-3 h-3 rounded-full bg-brand"></span>
                            </div>
                            <div class="flex flex-col justify-between gap-6 min-w-0">
                                <div class="min-w-0">
                                    <p class="text-base font-bold text-brand leading-tight truncate">{{ trip.departureCity }}</p>
                                    <p class="text-xs text-brand/40 truncate">{{ trip.departureAddress }}</p>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-base font-bold text-brand leading-tight truncate">{{ trip.arrivalCity }}</p>
                                    <p class="text-xs text-brand/40 truncate">{{ trip.arrivalAddress }}</p>
                                </div>
                            </div>
                        </div>

                        {# Prix #}
                        <div class="text-right shrink-0">
                            <p class="text-2xl font-extrabold text-brand leading-none">
                                {{ trip.price|number_format(trip.price == trip.price|round ? 0 : 2, ',', ' ') }}&nbsp;&euro;
                            </p>
                            <p class="text-[11px] text-brand/40 mt-1">par passager</p>
                        </div>
                    </div>

                    {# Conducteur + infos #}
                    <div class="flex items-center gap-3 px-5 sm:px-6 py-3.5 border-t border-black/5 bg-cream/40">
                        {% if driver.avatar %}
                            <img src="{{ driver.avatar }}" alt="" class="w-9 h-9 rounded-full object-cover">
                        {% else %}
                            <span class="w-9 h-9 rounded-full bg-brand text-lime text-sm font-bold flex items-center justify-center">{{ driver.firstName|first|upper }}</span>
                        {% endif %}
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-bold text-brand truncate">{{ driver.firstName }}</p>
                            <p class="text-xs text-brand/50 truncate">
                                {% if rating %}<span class="text-amber-500">★</span> {{ rating.avg }} ({{ rating.count }}){% else %}Nouveau membre{% endif %}
                                {% if trip.vehicle %} · {{ trip.vehicle.brand }} {{ trip.vehicle.model }}{% endif %}
                            </p>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            {% if trip.avoidHighway %}
                                <span title="Sans autoroute" class="hidden sm:flex w-8 h-8 rounded-full bg-white border border-black/5 text-brand/50 items-center justify-center">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M4 20 8 4M20 20 16 4M12 6v2M12 11v2M12 16v2"/></svg>
                                </span>
                            {% endif %}
                            {% if driver.petsAllowed %}
                                <span title="Animaux acceptes" class="hidden sm:flex w-8 h-8 rounded-full bg-white border border-black/5 text-brand/50 items-center justify-center">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="5" cy="10" r="1.6"/><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="19" cy="10" r="1.6"/><path d="M8 17c0-2.5 1.8-5 4-5s4 2.5 4 5c0 1.7-1.3 2-2 2h-4c-.7 0-2-.3-2-2z"/></svg>
                                </span>
                            {% endif %}
                            <span class="text-xs font-bold px-3 py-1.5 rounded-full {{ trip.availableSeats <= 1 ? 'bg-amber-50 text-amber-700' : 'bg-lime-soft text-brand' }}">
                                {{ trip.availableSeats <= 1 ? 'Derniere place' : trip.availableSeats ~ ' places' }}
                            </span>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
