{% extends 'base.html.twig' %}

{% block title %}{{ trip.departureCity }} → {{ trip.arrivalCity }}, {{ trip.departureAt|date_fr }} — Covoite{% endblock %}

{% block body %}
{% set driver   = trip.driver %}
{% set isDriver = app.user and app.user.id == driver.id %}
{% set canBook  = isUpcoming and trip.status.value == 'active' and trip.availableSeats > 0 and not isDriver and myBooking is null %}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">

    <a href="{{ path('app_search') }}"
       class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand/50 hover:text-brand transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Tous les trajets
    </a>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-brand tracking-tight mt-4 first-letter:uppercase">
        {{ trip.departureAt|date_fr('long') }}
    </h1>

    {% if isDriver %}
        <div class="mt-5 bg-brand text-cream rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-3">
            <p class="text-sm flex-1"><strong class="text-lime">C'est votre trajet.</strong> Voici ce que voient les passagers.</p>
            <a href="{{ path('app_ride_driver', {id: trip.id}) }}"
               class="text-center bg-lime hover:bg-lime-hover text-brand text-sm font-semibold px-5 py-2.5 rounded-full transition">
                Gerer le trajet
            </a>
        </div>
    {% endif %}

    <div class="grid lg:grid-cols-[1fr_340px] gap-8 mt-6">

        {# ══════════ COLONNE PRINCIPALE ══════════ #}
        <div class="min-w-0">

            {# Itineraire #}
            <section class="bg-white rounded-2xl border border-black/5 shadow-card p-5 sm:p-6">
                <div class="flex gap-4">
                    <div class="w-12 shrink-0 pt-0.5">
                        <p class="text-base font-extrabold text-brand">{{ trip.departureAt|date('H:i') }}</p>
                    </div>
                    <div class="flex flex-col items-center pt-1.5">
                        <span class="w-3 h-3 rounded-full border-2 border-brand bg-white"></span>
                        <span class="w-0.5 flex-1 bg-brand my-1"></span>
                        <span class="w-3 h-3 rounded-full border-2 border-brand bg-white"></span>
                    </div>
                    <div class="flex flex-col gap-7 min-w-0">
                        <div>
                            <p class="text-base font-bold text-brand flex items-center gap-1 -my-1">{{ trip.departureCity }} {% include 'trip/_map_button.html.twig' with {focus: 'from'} %}</p>
                            <p class="text-sm text-brand/50 mt-0.5">{{ trip.departureAddress }}</p>
                        </div>
                        <div>
                            <p class="text-base font-bold text-brand flex items-center gap-1 -my-1">{{ trip.arrivalCity }} {% include 'trip/_map_button.html.twig' with {focus: 'to'} %}</p>
                            <p class="text-sm text-brand/50 mt-0.5">{{ trip.arrivalAddress }}</p>
                        </div>
                    </div>
                </div>
            </section>

            {# Conducteur #}
            <section class="mt-4 bg-white rounded-2xl border border-black/5 shadow-card">
                <a href="{{ path('app_profile_show', {id: driver.id}) }}" class="flex items-center gap-4 p-5 sm:p-6 group">
                    {% if driver.avatar %}
                        <img src="{{ driver.avatar }}" alt="" class="w-14 h-14 rounded-full object-cover">
                    {% else %}
                        <span class="w-14 h-14 rounded-full bg-brand text-lime text-lg font-bold flex items-center justify-center">{{ driver.firstName|first|upper }}</span>
                    {% endif %}
                    <span class="flex-1 min-w-0">
                        <span class="block text-lg font-extrabold text-brand group-hover:underline">{{ driver.firstName }} {{ driver.lastName|first }}.</span>
                        <span class="block text-sm text-brand/50">
                            {% if avgRating %}<span class="text-amber-500">★</span> {{ avgRating }}/5 · {{ reviewCount }} avis · {% endif %}
                            {{ driver.tripsCompleted }} trajet{{ driver.tripsCompleted > 1 ? 's' }} effectue{{ driver.tripsCompleted > 1 ? 's' }}
                        </span>
                    </span>
                    <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>

                {% if trip.bio %}
                    <p class="mx-5 sm:mx-6 mb-5 text-sm text-brand/70 bg-cream rounded-xl px-4 py-3 leading-relaxed">{{ trip.bio }}</p>
                {% endif %}

                <ul class="border-t border-black/5 px-5 sm:px-6 py-4 grid sm:grid-cols-2 gap-3 text-sm text-brand/70">
                    <li class="flex items-center gap-2.5">
                        <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/></svg>
                        {{ driver.smokingAllowed ? 'Cigarette acceptee' : 'Non-fumeur' }}
                    </li>
                    <li class="flex items-center gap-2.5">
                        <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="5" cy="10" r="1.6"/><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="19" cy="10" r="1.6"/><path d="M8 17c0-2.5 1.8-5 4-5s4 2.5 4 5c0 1.7-1.3 2-2 2h-4c-.7 0-2-.3-2-2z"/></svg>
                        {{ driver.petsAllowed ? 'Animaux bienvenus' : 'Pas d\'animaux' }}
                    </li>
                    <li class="flex items-center gap-2.5">
                        <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                        {{ driver.musicGenre|music_label }}
                    </li>
                    <li class="flex items-center gap-2.5">
                        <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                        {{ trip.luggageAllowed|luggage_label }}
                    </li>
                    {% if trip.avoidHighway %}
                        <li class="flex items-center gap-2.5">
                            <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24"><path d="M4 20 8 4M20 20 16 4M12 6v2M12 11v2M12 16v2"/></svg>
                            Evite les autoroutes
                        </li>
                    {% endif %}
                    {% if trip.vehicle %}
                        <li class="flex items-center gap-2.5">
                            <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 17h14M5 17a2 2 0 1 0 4 0M15 17a2 2 0 1 0 4 0M3 17v-4l2-5a2 2 0 0 1 1.9-1.4h10.2A2 2 0 0 1 19 8l2 5v4"/></svg>
                            {{ trip.vehicle.brand }} {{ trip.vehicle.model }} · {{ trip.vehicle.color }}
                        </li>
                    {% endif %}
                </ul>
            </section>

            {# Avis #}
            {% if reviews is not empty %}
                <section class="mt-4 bg-white rounded-2xl border border-black/5 shadow-card p-5 sm:p-6">
                    <h2 class="text-sm font-bold text-brand">Ce que disent les passagers de {{ driver.firstName }}</h2>
                    <div class="mt-4 space-y-4">
                        {% for review in reviews %}
                            <div class="flex gap-3">
                                <span class="w-9 h-9 rounded-full bg-cream text-brand text-xs font-bold flex items-center justify-center shrink-0">{{ review.author.firstName|first|upper }}</span>
                                <div>
                                    <p class="text-sm font-semibold text-brand">
                                        {{ review.author.firstName }}
                                        <span class="text-amber-500 ml-1 tracking-tight">{% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}</span>
                                    </p>
                                    {% if review.comment %}<p class="text-sm text-brand/60 mt-0.5 leading-relaxed">{{ review.comment }}</p>{% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>

        {# ══════════ COLONNE RESERVATION ══════════ #}
        <aside>
            <div class="bg-white rounded-2xl border border-black/5 shadow-card p-5 sm:p-6 lg:sticky lg:top-24">
                <div class="flex items-end justify-between">
                    <div>
                        <p class="text-3xl font-extrabold text-brand">{{ trip.price|number_format(2, ',', ' ') }} &euro;</p>
                        <p class="text-xs text-brand/50">par passager</p>
                    </div>
                    <p class="text-sm font-semibold {{ trip.availableSeats > 0 ? 'text-brand' : 'text-red-600' }}">
                        {% if trip.availableSeats > 0 %}{{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' }} libre{{ trip.availableSeats > 1 ? 's' }}{% else %}Complet{% endif %}
                    </p>
                </div>

                <div class="mt-5 space-y-2">
                    {% if isDriver %}
                        <a href="{{ path('app_ride_driver', {id: trip.id}) }}" class="block text-center w-full bg-lime hover:bg-lime-hover text-brand font-semibold text-sm py-3.5 rounded-full transition">
                            Gerer mon trajet
                        </a>
                    {% elseif myBooking %}
                        <a href="{{ path('app_ride_passenger', {id: myBooking.id}) }}" class="block text-center w-full bg-brand hover:bg-brand-light text-cream font-semibold text-sm py-3.5 rounded-full transition">
                            Voir ma reservation
                        </a>
                    {% elseif canBook %}
                        <a href="{{ app.user ? path('app_booking_create', {id: trip.id}) : path('app_login') }}"
                           class="block text-center w-full bg-lime hover:bg-lime-hover text-brand font-semibold text-sm py-3.5 rounded-full transition">
                            {{ app.user ? 'Demander a reserver' : 'Se connecter pour reserver' }}
                        </a>
                    {% else %}
                        <p class="text-center text-sm font-semibold text-brand/50 bg-cream rounded-full py-3.5">
                            {% if trip.status.value == 'cancelled' %}Trajet annule{% elseif not isUpcoming %}Trajet passe{% else %}Plus de place disponible{% endif %}
                        </p>
                    {% endif %}

                    {% if app.user and not isDriver %}
                        <a href="{{ path('app_message_thread', {id: driver.id, trip: trip.id}) }}"
                           class="flex items-center justify-center gap-2 w-full border border-brand/15 hover:border-brand/40 text-brand font-semibold text-sm py-3 rounded-full transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Poser une question
                        </a>
                    {% endif %}
                </div>

                {% if canBook %}
                    <p class="text-center text-xs text-brand/40 mt-3">Le conducteur valide votre demande. Annulation gratuite avant le depart.</p>
                {% endif %}
            </div>
        </aside>
    </div>
</div>
{% include 'trip/_route_map.html.twig' %}
{% endblock %}
