{% extends 'base.html.twig' %}

{% block title %}Modifier le trajet {{ trip.departureCity }} → {{ trip.arrivalCity }} — Covoite{% endblock %}

{# L'assistant a sa propre barre en bas : pas de footer #}
{% block footer %}{% endblock %}

{% block body %}
    {# En modification, l'assistant s'ouvre directement sur le recapitulatif :
       on clique sur "Modifier" a cote de ce qu'on veut changer. #}
    {% include 'trip/_wizard.html.twig' with {
        mode: 'edit',
        closeUrl: path('app_ride_driver', {id: trip.id}),
        confirmedSeats: confirmedSeats,
    } %}
{% endblock %}
