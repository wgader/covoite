{% extends 'base.html.twig' %}

{% block title %}Covoite — Trouvez votre trajet, partagez la route{% endblock %}

{% block body %}

{# ══════════════════════════ HERO ══════════════════════════ #}
{# overflow-x-clip (et pas overflow-hidden) : on coupe les formes decoratives qui depassent
   sur les cotes, mais PAS les listes de suggestions / le calendrier qui descendent sous la section #}
<section class="relative overflow-x-clip">
    {# Formes decoratives douces en fond #}
    <div class="absolute -top-24 -left-24 w-72 h-72 rounded-full bg-lime/10 blur-2xl pointer-events-none"></div>
    <div class="absolute top-40 -right-32 w-96 h-96 rounded-full bg-lime/10 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-12 lg:pt-16 pb-10 grid lg:grid-cols-[1.05fr_1fr] gap-8 lg:gap-4 items-center">
        <div>
            <p class="text-[11px] font-semibold tracking-[.3em] uppercase text-brand/50">Le covoiturage, plus proche de vous</p>
            <h1 class="text-[2.6rem] leading-[1.05] sm:text-6xl font-extrabold text-brand tracking-tight mt-5">
                Trouvez votre trajet,<br>
                <span class="relative inline-block">
                    partagez la route.
                    <svg class="absolute left-0 -bottom-3 w-full h-4 text-lime" viewBox="0 0 300 16" preserveAspectRatio="none" fill="none">
                        <path d="M3 11C70 4 160 2 297 8" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
                    </svg>
                </span>
            </h1>
            <p class="text-base sm:text-lg text-brand/60 leading-relaxed mt-8 max-w-md">
                Covoite met en relation des personnes qui vont dans la meme direction.
                Un trajet plus simple, plus economique et plus humain.
            </p>
        </div>

        <div class="relative">
            <img src="{{ asset('images/home/hero.png') }}" alt="Une voiture pleine d'amis roule vers un village"
                 class="w-full max-w-xl mx-auto mix-blend-multiply select-none" width="1200" height="900" fetchpriority="high">
        </div>
    </div>

    {# ── BARRE DE RECHERCHE ── #}
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pb-12">
        {% include 'trip/_search_form.html.twig' with {size: 'lg'} %}

        {# Les 3 promesses #}
        <div class="grid grid-cols-3 gap-2 sm:gap-6 mt-8 max-w-2xl">
            {% for f in [
                {t: 'Moins de CO2', s: 'pour la planete', d: 'M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10zM2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12'},
                {t: 'Moins cher', s: 'pour ton budget', d: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'},
                {t: 'Plus de lien', s: 'sur la route', d: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8'},
            ] %}
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 {{ not loop.first ? 'sm:border-l sm:border-black/10 sm:pl-6' }}">
                    <svg class="w-7 h-7 text-lime shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="{{ f.d }}"/></svg>
                    <div>
                        <p class="text-sm font-semibold text-brand leading-tight">{{ f.t }}</p>
                        <p class="text-xs text-brand/50">{{ f.s }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ══════════════════════════ PROCHAINS DEPARTS ══════════════════════════ #}
{% if trips is not empty %}
<section class="bg-white py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-end justify-between gap-4">
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-brand tracking-tight">Les prochains departs</h2>
                <p class="text-sm text-brand/50 mt-1">Reservez une place en quelques secondes.</p>
            </div>
            <a href="{{ path('app_search') }}" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline">
                Tout voir
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
            {% for trip in trips %}
                <a href="{{ path('app_trip_show', {id: trip.id}) }}"
                   class="group bg-cream/60 hover:bg-white border border-black/5 hover:shadow-pop hover:-translate-y-0.5 rounded-2xl p-5 transition flex flex-col">
                    <p class="text-xs font-semibold text-brand/50 first-letter:uppercase">{{ trip.departureAt|date_fr }}</p>
                    <div class="flex gap-3 mt-3">
                        <p class="text-sm font-bold text-brand w-11">{{ trip.departureAt|date('H:i') }}</p>
                        <div class="flex flex-col items-center pt-1.5">
                            <span class="w-2.5 h-2.5 rounded-full border-2 border-brand bg-white"></span>
                            <span class="w-0.5 h-5 bg-brand"></span>
                            <span class="w-2.5 h-2.5 rounded-full border-2 border-brand bg-white"></span>
                        </div>
                        <div class="flex flex-col gap-2.5 min-w-0">
                            <p class="text-sm font-semibold text-brand leading-none truncate">{{ trip.departureCity }}</p>
                            <p class="text-sm font-semibold text-brand leading-none truncate">{{ trip.arrivalCity }}</p>
                        </div>
                        <p class="ml-auto text-lg font-extrabold text-brand">{{ trip.price|number_format(0, ',', ' ') }}&nbsp;&euro;</p>
                    </div>
                    <div class="flex items-center gap-2.5 mt-5 pt-4 border-t border-black/5">
                        {% if trip.driver.avatar %}
                            <img src="{{ trip.driver.avatar }}" alt="" class="w-8 h-8 rounded-full object-cover">
                        {% else %}
                            <span class="w-8 h-8 rounded-full bg-brand text-lime text-xs font-bold flex items-center justify-center">{{ trip.driver.firstName|first|upper }}</span>
                        {% endif %}
                        <span class="text-sm font-semibold text-brand">{{ trip.driver.firstName }}</span>
                        <span class="ml-auto text-xs text-brand/50">{{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' }}</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ══════════════════════════ COMMENT CA MARCHE ══════════════════════════ #}
<section id="comment-ca-marche" class="py-16 sm:py-24 scroll-mt-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-xl mx-auto">
            <p class="text-[11px] font-semibold tracking-[.3em] uppercase text-brand/50">Comment ca marche</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-brand tracking-tight mt-3">Trois etapes, et c'est parti.</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mt-12">
            {% for step in [
                {img: 'step-search.png', n: '1', t: 'Recherchez', d: 'Indiquez votre depart, votre arrivee et la date. On vous montre les conducteurs qui font la route.'},
                {img: 'step-book.png',   n: '2', t: 'Reservez',   d: 'Choisissez votre trajet, envoyez une demande. Le conducteur l\'accepte, votre place est garantie.'},
                {img: 'step-travel.png', n: '3', t: 'Voyagez',    d: 'Retrouvez-vous au point de rendez-vous, partagez les frais... et la playlist.'},
            ] %}
                <article class="bg-white rounded-3xl border border-black/5 shadow-card overflow-hidden">
                    <div class="aspect-[4/3] bg-cream flex items-center justify-center overflow-hidden">
                        <img src="{{ asset('images/home/' ~ step.img) }}" alt="" loading="lazy" class="w-full h-full object-cover mix-blend-multiply">
                    </div>
                    <div class="p-6">
                        <span class="inline-flex w-8 h-8 rounded-full bg-lime text-brand text-sm font-extrabold items-center justify-center">{{ step.n }}</span>
                        <h3 class="text-lg font-extrabold text-brand mt-3">{{ step.t }}</h3>
                        <p class="text-sm text-brand/60 leading-relaxed mt-1.5">{{ step.d }}</p>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</section>

{# ══════════════════════════ CONDUCTEURS ══════════════════════════ #}
<section class="px-4 sm:px-6">
    <div class="max-w-6xl mx-auto bg-brand rounded-[2rem] overflow-hidden grid lg:grid-cols-2 items-center">
        <div class="p-8 sm:p-12 lg:p-16">
            <p class="text-[11px] font-semibold tracking-[.3em] uppercase text-lime">Vous conduisez ?</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-cream tracking-tight mt-3 leading-tight">
                Vos sieges vides peuvent payer votre essence.
            </h2>
            <p class="text-cream/60 leading-relaxed mt-4 max-w-md">
                Publiez votre trajet en 2 minutes, choisissez vos passagers et partagez les frais de route.
                Vous gardez la main sur tout : horaire, prix, places.
            </p>
            <ul class="mt-6 space-y-2.5 text-sm text-cream/80">
                {% for item in ['Vous acceptez ou refusez chaque demande', 'Paiement securise, sans gerer la monnaie', 'Annulation simple si vos plans changent'] %}
                    <li class="flex items-center gap-2.5">
                        <span class="w-5 h-5 rounded-full bg-lime text-brand flex items-center justify-center shrink-0">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                        {{ item }}
                    </li>
                {% endfor %}
            </ul>
            <a href="{{ path('app_trip_new') }}"
               class="inline-flex items-center gap-2 bg-lime hover:bg-lime-hover text-brand font-bold text-sm px-7 py-3.5 rounded-full transition mt-8">
                Proposer un trajet
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        </div>
        <div class="bg-lime-soft self-stretch flex items-center justify-center p-6 lg:p-10">
            <img src="{{ asset('images/home/driver.png') }}" alt="Un conducteur souriant au volant" loading="lazy"
                 class="w-full max-w-md mix-blend-multiply">
        </div>
    </div>
</section>

{# ══════════════════════════ COMMUNAUTE + CHIFFRES ══════════════════════════ #}
<section class="py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid lg:grid-cols-2 gap-10 items-center">
        <img src="{{ asset('images/home/community.png') }}" alt="Des voyageurs attendent au point de rendez-vous" loading="lazy"
             class="w-full mix-blend-multiply order-2 lg:order-1">
        <div class="order-1 lg:order-2">
            <p class="text-[11px] font-semibold tracking-[.3em] uppercase text-brand/50">La communaute</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-brand tracking-tight mt-3 leading-tight">
                Plus qu'un trajet,<br>une communaute.
            </h2>
            <p class="text-brand/60 leading-relaxed mt-4 max-w-md">
                Profils verifies, avis apres chaque trajet, messagerie integree :
                vous savez toujours avec qui vous partez.
            </p>
            <dl class="grid grid-cols-3 gap-4 mt-8">
                <div class="bg-white rounded-2xl border border-black/5 shadow-card p-4">
                    <dt class="text-xs text-brand/50">Trajets en ligne</dt>
                    <dd class="text-2xl sm:text-3xl font-extrabold text-brand mt-1">{{ tripCount }}</dd>
                </div>
                <div class="bg-white rounded-2xl border border-black/5 shadow-card p-4">
                    <dt class="text-xs text-brand/50">Membres</dt>
                    <dd class="text-2xl sm:text-3xl font-extrabold text-brand mt-1">{{ userCount }}</dd>
                </div>
                <div class="bg-white rounded-2xl border border-black/5 shadow-card p-4">
                    <dt class="text-xs text-brand/50">Reservations</dt>
                    <dd class="text-2xl sm:text-3xl font-extrabold text-brand mt-1">{{ bookingCount }}</dd>
                </div>
            </dl>
        </div>
    </div>
</section>

{# ══════════════════════════ CTA FINAL ══════════════════════════ #}
{% if not app.user %}
<section class="pb-20 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto text-center bg-white rounded-[2rem] border border-black/5 shadow-card px-6 py-12 sm:py-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand tracking-tight">Ensemble, allons plus loin.</h2>
        <p class="text-brand/60 mt-3">Inscription gratuite, en moins d'une minute.</p>
        <div class="flex flex-col sm:flex-row gap-2 justify-center mt-8">
            <a href="{{ path('app_register') }}" class="bg-lime hover:bg-lime-hover text-brand font-bold text-sm px-8 py-3.5 rounded-full transition">
                Creer mon compte
            </a>
            <a href="{{ path('app_search') }}" class="border border-brand/15 hover:border-brand/40 text-brand font-bold text-sm px-8 py-3.5 rounded-full transition">
                Voir les trajets
            </a>
        </div>
    </div>
</section>
{% endif %}

{% endblock %}
