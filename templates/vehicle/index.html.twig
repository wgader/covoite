{% extends 'base.html.twig' %}

{% block title %}Mes vehicules — Covoite{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10">

    <a href="{{ path('app_profile_me') }}"
       class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand/50 hover:text-brand transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Mon profil
    </a>

    <div class="flex items-end justify-between gap-4 mt-4">
        <div>
            <h1 class="text-3xl font-extrabold text-brand tracking-tight">Mes vehicules</h1>
            <p class="text-sm text-brand/50 mt-1">Les passagers voient le modele et la couleur pour vous reconnaitre.</p>
        </div>
        {% if vehicles is not empty %}
            <a href="{{ path('app_vehicle_new') }}"
               class="shrink-0 inline-flex items-center gap-2 bg-lime hover:bg-lime-hover text-brand font-semibold text-sm px-5 py-2.5 rounded-full transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
                Ajouter
            </a>
        {% endif %}
    </div>

    {% if vehicles is empty %}
        <div class="bg-white rounded-3xl border border-black/5 shadow-card p-10 sm:p-14 text-center mt-8">
            <div class="w-16 h-16 bg-lime-soft rounded-2xl flex items-center justify-center mx-auto text-brand">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 17h14M5 17a2 2 0 1 0 4 0M15 17a2 2 0 1 0 4 0M3 17v-4l2-5a2 2 0 0 1 1.9-1.4h10.2A2 2 0 0 1 19 8l2 5v4"/></svg>
            </div>
            <p class="text-lg font-extrabold text-brand mt-5">Aucun vehicule pour l'instant</p>
            <p class="text-sm text-brand/50 mt-1">Ajoutez votre voiture pour publier des trajets plus rapidement.</p>
            <a href="{{ path('app_vehicle_new') }}"
               class="inline-flex items-center gap-2 bg-lime hover:bg-lime-hover text-brand font-semibold text-sm px-6 py-3 rounded-full transition mt-6">
                Ajouter mon vehicule
            </a>
        </div>
    {% else %}
        <div class="space-y-3 mt-8">
            {% for vehicle in vehicles %}
                <article class="bg-white rounded-2xl border shadow-card p-5 flex items-center gap-4 {{ vehicle.default ? 'border-lime/60' : 'border-black/5' }}">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 {{ vehicle.default ? 'bg-lime-soft text-brand' : 'bg-cream text-brand/50' }}">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 17h14M5 17a2 2 0 1 0 4 0M15 17a2 2 0 1 0 4 0M3 17v-4l2-5a2 2 0 0 1 1.9-1.4h10.2A2 2 0 0 1 19 8l2 5v4"/></svg>
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-bold text-brand">{{ vehicle.brand }} {{ vehicle.model }}</p>
                            {% if vehicle.default %}
                                <span class="text-[11px] font-bold bg-lime text-brand px-2 py-0.5 rounded-full">Par defaut</span>
                            {% endif %}
                        </div>
                        <p class="text-xs text-brand/50 mt-1">
                            {{ vehicle.color }} · {{ vehicle.seats }} places
                            {%- if vehicle.electric %} · Electrique{% endif %}
                            {%- if vehicle.hasAc %} · Clim{% endif %}
                            {%- if vehicle.hasUsb %} · USB{% endif %}
                        </p>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0">
                        <a href="{{ path('app_vehicle_edit', {id: vehicle.id}) }}" aria-label="Modifier {{ vehicle.brand }} {{ vehicle.model }}"
                           class="w-9 h-9 rounded-full border border-black/10 text-brand/60 hover:text-brand hover:border-brand/30 flex items-center justify-center transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        </a>
                        <form method="post" action="{{ path('app_vehicle_delete', {id: vehicle.id}) }}"
                              data-confirm="{{ vehicle.brand }} {{ vehicle.model }} sera retire de votre compte."
                              data-confirm-title="Supprimer ce vehicule ?"
                              data-confirm-button="Supprimer"
                              data-confirm-tone="danger">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-vehicle-' ~ vehicle.id) }}">
                            <button aria-label="Supprimer {{ vehicle.brand }} {{ vehicle.model }}"
                                    class="w-9 h-9 rounded-full border border-black/10 text-brand/60 hover:text-red-600 hover:border-red-200 flex items-center justify-center transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
                            </button>
                        </form>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
