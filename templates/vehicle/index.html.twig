{% extends 'base.html.twig' %}

{% block title %}Mes vehicules — Covoite{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-6 py-10">

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-extrabold text-brand">Mes vehicules</h1>
            <p class="text-sm text-brand/40 mt-1">Gerez vos vehicules pour vos trajets.</p>
        </div>
        <a href="{{ path('app_vehicle_new') }}"
           class="flex items-center gap-2 bg-lime hover:bg-lime-hover text-brand font-semibold text-sm px-5 py-2.5 rounded-xl transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
            Ajouter
        </a>
    </div>

    {% if vehicles is empty %}
        <div class="bg-white border border-black/6 rounded-2xl p-16 text-center">
            <div class="w-16 h-16 bg-cream rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-brand/25" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                </svg>
            </div>
            <p class="text-brand font-semibold mb-2">Aucun vehicule</p>
            <p class="text-sm text-brand/40 mb-6">Ajoutez un vehicule pour publier des trajets.</p>
            <a href="{{ path('app_vehicle_new') }}"
               class="inline-flex items-center gap-2 bg-lime hover:bg-lime-hover text-brand font-semibold text-sm px-5 py-2.5 rounded-xl transition">
                Ajouter mon premier vehicule
            </a>
        </div>
    {% else %}
        <div class="space-y-3">
            {% for vehicle in vehicles %}
                <div class="bg-white border border-black/6 {% if vehicle.default %}border-lime/40{% endif %} rounded-2xl p-5 flex items-center gap-5">

                    <div class="w-12 h-12 bg-cream rounded-xl flex items-center justify-center flex-shrink-0">
                        <svg class="w-6 h-6 text-brand/40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                        </svg>
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-0.5">
                            <p class="font-bold text-brand">{{ vehicle.brand }} {{ vehicle.model }}</p>
                            {% if vehicle.default %}
                                <span class="text-xs bg-lime/20 text-brand font-semibold px-2 py-0.5 rounded-full">
                                    Par defaut
                                </span>
                            {% endif %}
                            {% if vehicle.electric %}
                                <span class="text-xs bg-brand/10 text-brand px-2 py-0.5 rounded-full">Electrique</span>
                            {% endif %}
                        </div>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-brand/40">
                            <span>{{ vehicle.color }}</span>
                            <span>{{ vehicle.seats }} places</span>
                            {% if vehicle.hasAc %}<span>Clim</span>{% endif %}
                            {% if vehicle.hasUsb %}<span>USB</span>{% endif %}
                        </div>
                    </div>

                    <div class="flex items-center gap-2 flex-shrink-0">
                        <a href="{{ path('app_vehicle_edit', {id: vehicle.id}) }}"
                           class="text-xs font-semibold text-brand border border-brand/15 px-3 py-1.5 rounded-lg hover:border-brand/40 transition">
                            Modifier
                        </a>
                        <form method="POST" action="{{ path('app_vehicle_delete', {id: vehicle.id}) }}"
                              onsubmit="return confirm('Supprimer ce vehicule ?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete-vehicle-' ~ vehicle.id) }}">
                            <button type="submit"
                                    class="text-xs font-semibold text-red-500 border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition">
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}