{% extends 'base.html.twig' %}

{% block title %}Inscription — Covoite{% endblock %}

{% block body %}
<div class="min-h-[80vh] flex items-center justify-center px-6 py-12">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-brand mb-2">Créer un compte</h1>
            <p class="text-brand/50 text-sm">Rejoignez la communauté Covoite</p>
        </div>

        {{ form_start(registrationForm, {attr: {class: 'bg-white rounded-2xl border border-black/8 p-8 shadow-sm space-y-5'}}) }}

            {# Erreurs globales #}
            {% if not registrationForm.vars.valid and registrationForm.vars.submitted %}
                <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl p-4 text-sm flex items-start gap-2">
                    <svg class="w-4 h-4 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    <div>
                        {# Erreurs qui ne concernent aucun champ en particulier (session expiree...) #}
                        {% for error in registrationForm.vars.errors %}
                            <p class="font-semibold">{{ error.message }}</p>
                        {% else %}
                            Veuillez corriger les erreurs ci-dessous.
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Prénom + Nom #}
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-brand mb-2">Prénom</label>
                    {{ form_widget(registrationForm.firstName, {attr: {
                        class: 'w-full px-4 py-3 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition',
                        placeholder: 'Pierre'
                    }}) }}
                    {% if registrationForm.firstName.vars.errors|length %}
                        <p class="text-red-600 text-xs mt-1">{{ registrationForm.firstName.vars.errors[0].message }}</p>
                    {% endif %}
                </div>
                <div>
                    <label class="block text-sm font-semibold text-brand mb-2">Nom</label>
                    {{ form_widget(registrationForm.lastName, {attr: {
                        class: 'w-full px-4 py-3 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition',
                        placeholder: 'Martin'
                    }}) }}
                    {% if registrationForm.lastName.vars.errors|length %}
                        <p class="text-red-600 text-xs mt-1">{{ registrationForm.lastName.vars.errors[0].message }}</p>
                    {% endif %}
                </div>
            </div>

            {# Email #}
            <div>
                <label class="block text-sm font-semibold text-brand mb-2">Adresse e-mail</label>
                {{ form_widget(registrationForm.email, {attr: {
                    class: 'w-full px-4 py-3 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition',
                    placeholder: 'vous@exemple.fr'
                }}) }}
                {% if registrationForm.email.vars.errors|length %}
                    <p class="text-red-600 text-xs mt-1">{{ registrationForm.email.vars.errors[0].message }}</p>
                {% endif %}
            </div>

            {# Date de naissance + Téléphone #}
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-brand mb-2">Date de naissance</label>
                    {{ form_widget(registrationForm.dateOfBirth, {attr: {
                        class: 'w-full px-4 py-3 border border-black/10 rounded-xl text-sm text-brand focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition'
                    }}) }}
                    {% if registrationForm.dateOfBirth.vars.errors|length %}
                        <p class="text-red-600 text-xs mt-1">{{ registrationForm.dateOfBirth.vars.errors[0].message }}</p>
                    {% endif %}
                </div>
                <div>
                    <label class="block text-sm font-semibold text-brand mb-2">
                        Téléphone
                        <span class="text-brand/30 font-normal">(facultatif)</span>
                    </label>
                    {{ form_widget(registrationForm.phone, {attr: {
                        class: 'w-full px-4 py-3 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition',
                        placeholder: '06 12 34 56 78'
                    }}) }}
                    {% if registrationForm.phone.vars.errors|length %}
                        <p class="text-red-600 text-xs mt-1">{{ registrationForm.phone.vars.errors[0].message }}</p>
                    {% endif %}
                </div>
            </div>

            {# Mot de passe #}
            <div>
                <label class="block text-sm font-semibold text-brand mb-2">Mot de passe</label>
                <div class="relative">
                    {{ form_widget(registrationForm.plainPassword.first, {attr: {
                        id: 'password_first',
                        class: 'w-full px-4 py-3 pr-12 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition',
                        placeholder: '8 caractères minimum'
                    }}) }}
                    <button type="button" id="togglePassword"
                            class="absolute inset-y-0 right-0 pr-4 flex items-center text-brand/30 hover:text-brand/60 transition">
                        <svg id="eyeOpen" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <svg id="eyeClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                        </svg>
                    </button>
                </div>
                {% if registrationForm.plainPassword.first.vars.errors|length %}
                    <p class="text-red-600 text-xs mt-1">{{ registrationForm.plainPassword.first.vars.errors[0].message }}</p>
                {% endif %}
            </div>

            {# Checklist mot de passe #}
            <div class="bg-cream rounded-xl p-4 space-y-2" id="passwordChecklist">
                <p class="text-xs font-semibold text-brand/50 mb-2">Le mot de passe doit contenir :</p>
                <div class="flex items-center gap-2 text-xs text-brand/50" id="check-length">
                    <svg class="w-4 h-4 shrink-0 text-brand/20" id="icon-length" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                    8 caractères minimum
                </div>
                <div class="flex items-center gap-2 text-xs text-brand/50" id="check-upper">
                    <svg class="w-4 h-4 shrink-0 text-brand/20" id="icon-upper" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                    Une lettre majuscule
                </div>
                <div class="flex items-center gap-2 text-xs text-brand/50" id="check-lower">
                    <svg class="w-4 h-4 shrink-0 text-brand/20" id="icon-lower" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                    Une lettre minuscule
                </div>
                <div class="flex items-center gap-2 text-xs text-brand/50" id="check-number">
                    <svg class="w-4 h-4 shrink-0 text-brand/20" id="icon-number" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                    Un chiffre
                </div>
                <div class="flex items-center gap-2 text-xs text-brand/50" id="check-special">
                    <svg class="w-4 h-4 shrink-0 text-brand/20" id="icon-special" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                    Un caractère spécial (!@#$%...)
                </div>
            </div>

            {# Répétition mot de passe #}
            <div>
                <label class="block text-sm font-semibold text-brand mb-2">Confirmer le mot de passe</label>
                <div class="relative">
                    {{ form_widget(registrationForm.plainPassword.second, {attr: {
                        id: 'password_second',
                        class: 'w-full px-4 py-3 pr-12 border border-black/10 rounded-xl text-sm text-brand placeholder-brand/30 focus:outline-none focus:ring-2 focus:ring-lime/50 focus:border-lime transition',
                        placeholder: 'Répétez votre mot de passe'
                    }}) }}
                    <button type="button" id="togglePassword2"
                            class="absolute inset-y-0 right-0 pr-4 flex items-center text-brand/30 hover:text-brand/60 transition">
                        <svg id="eyeOpen2" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                        <svg id="eyeClosed2" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
                        </svg>
                    </button>
                </div>
                {# Erreur mismatch (vient du parent RepeatedType) #}
                {% if registrationForm.plainPassword.vars.errors|length %}
                    <p class="text-red-600 text-xs mt-1">{{ registrationForm.plainPassword.vars.errors[0].message }}</p>
                {% endif %}
                {# Indicateur live de correspondance #}
                <p id="matchHint" class="text-xs mt-1 hidden"></p>
            </div>

            {# CGU #}
            <div>
                <div class="flex items-start gap-3">
                    {{ form_widget(registrationForm.agreeTerms, {attr: {
                        class: 'mt-0.5 w-4 h-4 accent-lime cursor-pointer'
                    }}) }}
                    <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-sm text-brand/60 cursor-pointer">
                        J'accepte les <a href="#" class="text-brand font-semibold hover:underline">conditions générales d'utilisation</a>
                    </label>
                </div>
                {% if registrationForm.agreeTerms.vars.errors|length %}
                    <p class="text-red-600 text-xs mt-2">{{ registrationForm.agreeTerms.vars.errors[0].message }}</p>
                {% endif %}
            </div>

            <button type="submit"
                    class="w-full bg-lime hover:bg-lime/90 text-brand font-bold py-3.5 rounded-xl transition text-sm flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Créer mon compte
            </button>

        {{ form_end(registrationForm) }}

        <p class="text-center text-sm text-brand/50 mt-6">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-brand font-semibold hover:underline">Se connecter</a>
        </p>

    </div>
</div>

<script>
// ── Helpers SVG ───────────────────────────────────────────────
const svgOk   = `<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>`;
const svgCirc = `<circle cx="12" cy="12" r="10"/>`;

// ── Œil mot de passe (champ 1) ────────────────────────────────
const pw1    = document.getElementById('password_first')
            || document.querySelector('input[name*="[first]"]');
const toggle1 = document.getElementById('togglePassword');
const eye1Open   = document.getElementById('eyeOpen');
const eye1Closed = document.getElementById('eyeClosed');

if (toggle1 && pw1) {
    toggle1.addEventListener('click', () => {
        const show = pw1.type === 'password';
        pw1.type = show ? 'text' : 'password';
        eye1Open.classList.toggle('hidden', show);
        eye1Closed.classList.toggle('hidden', !show);
    });
}

// ── Œil mot de passe (champ 2) ────────────────────────────────
const pw2    = document.getElementById('password_second')
            || document.querySelector('input[name*="[second]"]');
const toggle2 = document.getElementById('togglePassword2');
const eye2Open   = document.getElementById('eyeOpen2');
const eye2Closed = document.getElementById('eyeClosed2');

if (toggle2 && pw2) {
    toggle2.addEventListener('click', () => {
        const show = pw2.type === 'password';
        pw2.type = show ? 'text' : 'password';
        eye2Open.classList.toggle('hidden', show);
        eye2Closed.classList.toggle('hidden', !show);
    });
}

// ── Checklist mot de passe ────────────────────────────────────
const checks = {
    length:  { el: document.getElementById('check-length'),  icon: document.getElementById('icon-length'),  test: v => v.length >= 8 },
    upper:   { el: document.getElementById('check-upper'),   icon: document.getElementById('icon-upper'),   test: v => /[A-Z]/.test(v) },
    lower:   { el: document.getElementById('check-lower'),   icon: document.getElementById('icon-lower'),   test: v => /[a-z]/.test(v) },
    number:  { el: document.getElementById('check-number'),  icon: document.getElementById('icon-number'),  test: v => /[0-9]/.test(v) },
    special: { el: document.getElementById('check-special'), icon: document.getElementById('icon-special'), test: v => /[^a-zA-Z0-9]/.test(v) },
};

if (pw1) {
    pw1.addEventListener('input', () => {
        const v = pw1.value;
        Object.values(checks).forEach(({ el, icon, test }) => {
            const ok = test(v);
            el.classList.toggle('text-brand/50', !ok);
            el.classList.toggle('text-brand', ok);
            icon.classList.toggle('text-brand/20', !ok);
            icon.classList.toggle('text-lime', ok);
            icon.innerHTML = ok ? svgOk : svgCirc;
        });
        updateMatch();
    });
}

// ── Indicateur de correspondance des mots de passe ───────────
const matchHint = document.getElementById('matchHint');

function updateMatch() {
    if (!pw2 || !pw1 || !matchHint) return;
    if (!pw2.value) { matchHint.classList.add('hidden'); return; }
    const match = pw1.value === pw2.value;
    matchHint.classList.remove('hidden', 'text-lime', 'text-red-500');
    matchHint.classList.add(match ? 'text-brand' : 'text-red-500');
    matchHint.textContent = match ? '✓ Les mots de passe correspondent' : '✗ Les mots de passe ne correspondent pas';
}

if (pw2) pw2.addEventListener('input', updateMatch);
</script>
{% endblock %}