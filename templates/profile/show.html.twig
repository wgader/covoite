{% extends 'base.html.twig' %}

{% block title %}{{ user.firstName }} {{ user.lastName }} — Covoite{% endblock %}

{% block body %}

<div class="max-w-4xl mx-auto px-6 py-10">

    <a href="javascript:history.back()"
       class="text-sm text-brand/50 hover:text-brand flex items-center gap-1 mb-8 transition">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
        </svg>
        Retour
    </a>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        {# COLONNE GAUCHE — identite #}
        <div class="flex flex-col gap-4">

            {# CARTE IDENTITE #}
            <div class="bg-white rounded-2xl border border-black/8 p-6 flex flex-col items-center text-center">
                {% if user.avatar %}
                    <img src="{{ user.avatar }}" alt="{{ user.firstName }}"
                         class="w-24 h-24 rounded-full object-cover border-4 border-lime/30 mb-4">
                {% else %}
                    <div class="w-24 h-24 rounded-full bg-brand flex items-center justify-center text-lime font-extrabold text-3xl mb-4">
                        {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                    </div>
                {% endif %}

                <h1 class="text-xl font-extrabold text-brand">{{ user.firstName }} {{ user.lastName }}</h1>

                <div class="flex items-center gap-1 mt-1">
                    <span class="w-2 h-2 rounded-full bg-lime"></span>
                    <span class="text-xs text-brand/40 font-medium">Membre verifie</span>
                </div>

                {% if user.dateOfBirth %}
                    <p class="text-sm text-brand/50 mt-2">
                        {{ ("now"|date("Y")) - (user.dateOfBirth|date("Y")) }} ans
                    </p>
                {% endif %}

                {# STATS #}
                <div class="flex gap-4 mt-5 pt-5 border-t border-black/6 w-full justify-center">
                    <div class="text-center">
                        <p class="text-2xl font-extrabold text-brand">{{ user.tripsCompleted }}</p>
                        <p class="text-xs text-brand/40">trajet{{ user.tripsCompleted != 1 ? 's' : '' }}</p>
                    </div>
                    {% if avgRating is defined and avgRating %}
                        <div class="text-center">
                            <p class="text-2xl font-extrabold text-brand">{{ avgRating }}</p>
                            <p class="text-xs text-brand/40">/ 5</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# BOUTON MESSAGE #}
            {% if app.user and app.user.id != user.id %}
                <a href="{{ path('app_message_thread', {'id': user.id}) }}"
                   class="inline-flex items-center justify-center gap-2 bg-lime text-brand font-semibold px-5 py-3 rounded-xl hover:bg-lime-hover transition text-sm w-full">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    Envoyer un message
                </a>
            {% endif %}

            {# PREFERENCES #}
            <div class="bg-white rounded-2xl border border-black/8 p-5">
                <h2 class="text-sm font-bold text-brand mb-4">Preferences en voiture</h2>
                <div class="flex flex-col gap-3">
                    {% if user.musicGenre %}
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-cream flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand/60">
                                    <path d="M9 18V5l12-2v13"/>
                                    <circle cx="6" cy="18" r="3"/>
                                    <circle cx="18" cy="16" r="3"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-xs text-brand/40 font-medium">Musique</p>
                                <p class="text-sm font-semibold text-brand">{{ user.musicGenre.value|capitalize }}</p>
                            </div>
                        </div>
                    {% endif %}

                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-cream flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand/60">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs text-brand/40 font-medium">Tabac</p>
                            <p class="text-sm font-semibold text-brand">
                                {% if user.smokingAllowed is null %}Non specifie
                                {% elseif user.smokingAllowed %}Autorise
                                {% else %}Non autorise{% endif %}
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-cream flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand/60">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs text-brand/40 font-medium">Animaux</p>
                            <p class="text-sm font-semibold text-brand">
                                {% if user.petsAllowed is null %}Non specifie
                                {% elseif user.petsAllowed %}Autorises
                                {% else %}Non autorises{% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {# COLONNE DROITE — bio + avis #}
        <div class="md:col-span-2 flex flex-col gap-5">

            {# BIO #}
            {% if user.bio %}
                <div class="bg-white rounded-2xl border border-black/8 p-6">
                    <h2 class="text-sm font-bold text-brand mb-3">A propos</h2>
                    <p class="text-sm text-brand/70 leading-relaxed">{{ user.bio }}</p>
                </div>
            {% endif %}

            {# AVIS RECUS #}
            {% if reviews is defined and reviews|length > 0 %}
                <div class="bg-white rounded-2xl border border-black/8 p-6">
                    <div class="flex items-center justify-between mb-5">
                        <h2 class="text-sm font-bold text-brand">Avis recus</h2>
                        {% if avgRating is defined and avgRating %}
                            <div class="flex items-center gap-1.5">
                                <span class="text-yellow-400">★</span>
                                <span class="font-bold text-brand text-sm">{{ avgRating }}/5</span>
                                <span class="text-brand/40 text-xs">({{ reviews|length }} avis)</span>
                            </div>
                        {% endif %}
                    </div>
                    <div class="flex flex-col gap-3">
                        {% for review in reviews %}
                            <div class="bg-cream rounded-xl p-4">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="w-7 h-7 rounded-full bg-brand/10 flex items-center justify-center text-xs font-bold text-brand">
                                            {{ review.author.firstName|first|upper }}
                                        </div>
                                        <span class="text-sm font-semibold text-brand">
                                            {{ review.author.firstName }} {{ review.author.lastName|first }}.
                                        </span>
                                    </div>
                                    <div class="text-yellow-400 text-sm">
                                        {% for i in 1..review.rating %}★{% endfor %}{% for i in (review.rating + 1)..5 %}☆{% endfor %}
                                    </div>
                                </div>
                                {% if review.comment %}
                                    <p class="text-sm text-brand/60 leading-relaxed">{{ review.comment }}</p>
                                {% endif %}
                                <p class="text-xs text-brand/30 mt-2">{{ review.createdAt|date('d/m/Y') }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="bg-white rounded-2xl border border-black/8 p-6">
                    <h2 class="text-sm font-bold text-brand mb-3">Avis recus</h2>
                    <p class="text-sm text-brand/40">Aucun avis pour le moment.</p>
                </div>
            {% endif %}

        </div>
    </div>
</div>

{% endblock %}