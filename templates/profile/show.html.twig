{% extends 'base.html.twig' %}

{% block title %}{{ isMe ? 'Mon profil' : user.firstName ~ ' ' ~ user.lastName|first ~ '.' }} — Covoite{% endblock %}

{% block body %}
{% set age = user.dateOfBirth ? date().diff(user.dateOfBirth).y : null %}

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    {# ══════════ EN-TETE ══════════ #}
    <section class="bg-white rounded-3xl border border-black/5 shadow-card p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center gap-5">
            {% if user.avatar %}
                <img src="{{ user.avatar }}" alt="" class="w-24 h-24 rounded-full object-cover ring-4 ring-lime-soft">
            {% else %}
                <span class="w-24 h-24 rounded-full bg-brand text-lime text-3xl font-extrabold flex items-center justify-center ring-4 ring-lime-soft">
                    {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                </span>
            {% endif %}

            <div class="flex-1 min-w-0">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-brand tracking-tight">
                    {{ user.firstName }} {{ isMe ? user.lastName : user.lastName|first ~ '.' }}
                </h1>
                <p class="text-sm text-brand/50 mt-1">
                    {% if age %}{{ age }} ans · {% endif %}Membre depuis {{ user.createdAt ? user.createdAt|date('Y') : '' }}
                </p>
                <div class="flex flex-wrap items-center gap-2 mt-3">
                    {% if avgRating %}
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-cream text-brand px-3 py-1.5 rounded-full">
                            <span class="text-amber-500">★</span> {{ avgRating }}/5 · {{ reviewCount }} avis
                        </span>
                    {% endif %}
                    <span class="inline-flex items-center text-xs font-semibold bg-cream text-brand px-3 py-1.5 rounded-full">
                        {{ user.tripsCompleted }} trajet{{ user.tripsCompleted > 1 ? 's' }} effectue{{ user.tripsCompleted > 1 ? 's' }}
                    </span>
                    {% if user.verifiedAt %}
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-lime-soft text-brand px-3 py-1.5 rounded-full">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Profil verifie
                        </span>
                    {% endif %}
                </div>
            </div>

            {% if isMe %}
                <button type="button" data-profile-toggle
                        class="self-start sm:self-center inline-flex items-center gap-2 text-sm font-semibold text-brand border border-brand/15 hover:border-brand/40 px-4 py-2.5 rounded-full transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    <span data-profile-toggle-label>Modifier</span>
                </button>
            {% elseif app.user %}
                <a href="{{ path('app_message_thread', {id: user.id}) }}"
                   class="self-start sm:self-center inline-flex items-center gap-2 text-sm font-semibold bg-lime hover:bg-lime-hover text-brand px-5 py-2.5 rounded-full transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Envoyer un message
                </a>
            {% endif %}
        </div>
    </section>

    {# ══════════ MODE EDITION (seulement pour moi) ══════════ #}
    {% if isMe %}
        <section data-profile-edit {{ editing ? '' : 'hidden' }} class="mt-4">
            {{ form_start(profileForm, {attr: {novalidate: 'novalidate', class: 'space-y-4'}}) }}

            <div class="bg-white rounded-3xl border border-black/5 shadow-card p-6 sm:p-8">
                <h2 class="text-base font-extrabold text-brand">Informations personnelles</h2>
                <div class="grid sm:grid-cols-2 gap-4 mt-5">
                    {% for field in [profileForm.firstName, profileForm.lastName, profileForm.dateOfBirth, profileForm.phone] %}
                        <div>
                            {{ form_label(field, null, {label_attr: {class: 'field-label'}}) }}
                            {{ form_widget(field, {attr: {class: 'field'}}) }}
                            <div class="form-error">{{ form_errors(field) }}</div>
                        </div>
                    {% endfor %}
                    {# ── Photo de profil : apercu + choix du fichier ── #}
                    <div class="sm:col-span-2" data-avatar-box>
                        <span class="field-label">Photo de profil</span>
                        <div class="flex items-center gap-4">
                            <span class="relative w-20 h-20 rounded-full overflow-hidden bg-brand text-lime text-2xl font-extrabold flex items-center justify-center shrink-0 ring-4 ring-lime-soft">
                                <img data-avatar-preview src="{{ user.avatar ?? '' }}" alt="" class="absolute inset-0 w-full h-full object-cover" {{ user.avatar ? '' : 'hidden' }}>
                                {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                            </span>
                            <div class="min-w-0">
                                <label class="inline-flex items-center gap-2 text-sm font-semibold text-brand border border-brand/15 hover:border-brand/40 px-4 py-2 rounded-full cursor-pointer transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 7h3l2-3h6l2 3h3v13H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                                    Choisir une photo
                                    {{ form_widget(profileForm.avatarFile, {attr: {class: 'sr-only', 'data-avatar-input': ''}}) }}
                                </label>
                                <p class="text-xs text-brand/40 mt-1.5">JPEG, PNG ou WebP, 4 Mo maximum. Elle sera recadree en carre.</p>
                                {% if user.avatar %}
                                    <label class="inline-flex items-center gap-2 text-xs font-semibold text-red-600 mt-2 cursor-pointer">
                                        {{ form_widget(profileForm.removeAvatar, {attr: {class: 'accent-red-600', 'data-avatar-remove': ''}}) }}
                                        Supprimer ma photo
                                    </label>
                                {% else %}
                                    {% do profileForm.removeAvatar.setRendered() %}
                                {% endif %}
                            </div>
                        </div>
                        <div class="form-error">{{ form_errors(profileForm.avatarFile) }}</div>
                    </div>
                    <div class="sm:col-span-2">
                        {{ form_label(profileForm.bio, null, {label_attr: {class: 'field-label'}}) }}
                        {{ form_widget(profileForm.bio, {attr: {class: 'field resize-none'}}) }}
                        <div class="form-error">{{ form_errors(profileForm.bio) }}</div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-black/5 shadow-card p-6 sm:p-8">
                <h2 class="text-base font-extrabold text-brand">Preferences en voiture</h2>
                <div class="mt-5">
                    {{ form_label(profileForm.musicGenre, null, {label_attr: {class: 'field-label'}}) }}
                    {{ form_widget(profileForm.musicGenre, {attr: {class: 'field cursor-pointer'}}) }}
                </div>
                <div class="mt-4 divide-y divide-black/5 border-t border-black/5">
                    {% for field in [profileForm.smokingAllowed, profileForm.petsAllowed] %}
                        <label class="flex items-center justify-between py-3.5 cursor-pointer">
                            <span class="text-sm font-medium text-brand">{{ field.vars.label }}</span>
                            {{ form_widget(field, {attr: {class: 'peer sr-only'}}) }}
                            <span class="relative w-11 h-6 rounded-full bg-black/15 transition peer-checked:bg-lime peer-focus-visible:ring-4 peer-focus-visible:ring-lime/30
                                         after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div class="flex flex-col-reverse sm:flex-row gap-2 sm:justify-end">
                <button type="button" data-profile-toggle class="px-6 py-3 rounded-full border border-brand/15 text-brand font-semibold text-sm hover:bg-white transition">
                    Annuler
                </button>
                <button type="submit" class="px-6 py-3 rounded-full bg-lime hover:bg-lime-hover text-brand font-semibold text-sm transition">
                    Enregistrer
                </button>
            </div>

            {{ form_end(profileForm) }}

            {# ── Zone sensible : suppression du compte (formulaire a part, avec mot de passe) ── #}
            <div class="mt-8 bg-white rounded-3xl border border-red-100 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center gap-4">
                <div class="flex-1">
                    <h2 class="text-base font-extrabold text-brand">Supprimer mon compte</h2>
                    <p class="text-sm text-brand/50 mt-1">Vos trajets et reservations a venir seront annules et vos informations personnelles effacees. C'est definitif.</p>
                </div>
                <button type="button" data-modal-open="delete-account"
                        class="shrink-0 px-5 py-2.5 rounded-full border border-red-200 text-red-600 font-semibold text-sm hover:bg-red-50 transition">
                    Supprimer mon compte
                </button>
            </div>
        </section>

        <div id="delete-account" hidden class="fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="delete-account-title">
            <div data-modal-backdrop class="anim-fade absolute inset-0 bg-brand/40 backdrop-blur-sm"></div>
            <form method="post" action="{{ path('app_account_delete') }}"
                  class="anim-modal relative w-full max-w-md bg-white rounded-3xl shadow-pop p-6 sm:p-7">
                <span class="w-12 h-12 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
                </span>
                <h2 id="delete-account-title" class="text-xl font-extrabold text-brand mt-4">Supprimer definitivement votre compte ?</h2>
                <ul class="text-sm text-brand/60 mt-3 space-y-1.5 list-disc pl-5">
                    <li>vos trajets a venir sont annules et vos passagers prevenus ;</li>
                    <li>vos reservations a venir sont annulees ;</li>
                    <li>votre nom, e-mail, telephone et photo sont effaces.</li>
                </ul>
                <label for="delete-password" class="field-label mt-5">Confirmez avec votre mot de passe</label>
                <input id="delete-password" type="password" name="password" required autocomplete="current-password" class="field">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                <div class="flex flex-col-reverse sm:flex-row gap-2 sm:justify-end mt-6">
                    <button type="button" data-modal-close class="px-5 py-2.5 rounded-full border border-brand/15 text-brand font-semibold text-sm hover:bg-cream transition">Annuler</button>
                    <button type="submit" class="px-5 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-semibold text-sm transition">Supprimer mon compte</button>
                </div>
            </form>
        </div>
    {% endif %}

    {# ══════════ MODE LECTURE ══════════ #}
    <div data-profile-view {{ isMe and editing ? 'hidden' : '' }} class="mt-4 grid gap-4">

        <section class="bg-white rounded-3xl border border-black/5 shadow-card p-6 sm:p-8">
            <h2 class="text-base font-extrabold text-brand">A propos</h2>
            {% if user.bio %}
                <p class="text-sm text-brand/70 leading-relaxed mt-3 whitespace-pre-line">{{ user.bio }}</p>
            {% else %}
                <p class="text-sm text-brand/40 mt-3">{{ isMe ? 'Ajoutez quelques mots pour que les autres membres vous connaissent.' : user.firstName ~ ' n\'a pas encore ecrit de presentation.' }}</p>
            {% endif %}

            <ul class="grid sm:grid-cols-3 gap-3 mt-6">
                <li class="bg-cream rounded-2xl p-4">
                    <p class="text-xs text-brand/50">Musique</p>
                    <p class="text-sm font-semibold text-brand mt-1">{{ user.musicGenre|music_label }}</p>
                </li>
                <li class="bg-cream rounded-2xl p-4">
                    <p class="text-xs text-brand/50">Cigarette</p>
                    <p class="text-sm font-semibold text-brand mt-1">{{ user.smokingAllowed ? 'Acceptee' : 'Non-fumeur' }}</p>
                </li>
                <li class="bg-cream rounded-2xl p-4">
                    <p class="text-xs text-brand/50">Animaux</p>
                    <p class="text-sm font-semibold text-brand mt-1">{{ user.petsAllowed ? 'Bienvenus' : 'Non' }}</p>
                </li>
            </ul>
        </section>

        {% if isMe %}
            <section class="bg-white rounded-3xl border border-black/5 shadow-card divide-y divide-black/5 overflow-hidden">
                <a href="{{ path('app_vehicle_index') }}" class="flex items-center justify-between px-6 sm:px-8 py-4 hover:bg-cream/60 transition">
                    <span>
                        <span class="block text-sm font-bold text-brand">Mes vehicules</span>
                        <span class="block text-xs text-brand/50 mt-0.5">{{ user.vehicles|length }} vehicule{{ user.vehicles|length > 1 ? 's' }} enregistre{{ user.vehicles|length > 1 ? 's' }}</span>
                    </span>
                    <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <a href="{{ path('app_rides') }}" class="flex items-center justify-between px-6 sm:px-8 py-4 hover:bg-cream/60 transition">
                    <span class="text-sm font-bold text-brand">Mes trajets</span>
                    <svg class="w-5 h-5 text-brand/40" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <div class="px-6 sm:px-8 py-4">
                    <p class="text-xs text-brand/50">Email du compte</p>
                    <p class="text-sm font-semibold text-brand mt-0.5">{{ user.email }}</p>
                </div>
            </section>
        {% endif %}

        {% if upcomingTrips is not empty %}
            <section class="bg-white rounded-3xl border border-black/5 shadow-card p-6 sm:p-8">
                <h2 class="text-base font-extrabold text-brand">Prochains trajets de {{ user.firstName }}</h2>
                <div class="mt-4 divide-y divide-black/5">
                    {% for t in upcomingTrips %}
                        <a href="{{ path('app_trip_show', {id: t.id}) }}" class="flex items-center gap-4 py-3.5 group">
                            <span class="text-xs font-semibold text-brand/50 w-20 shrink-0 first-letter:uppercase">{{ t.departureAt|date_fr }}</span>
                            <span class="flex-1 text-sm font-semibold text-brand group-hover:underline truncate">{{ t.departureCity }} → {{ t.arrivalCity }}</span>
                            <span class="text-sm font-bold text-brand">{{ t.price|number_format(2, ',', ' ') }} &euro;</span>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <section class="bg-white rounded-3xl border border-black/5 shadow-card p-6 sm:p-8">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-extrabold text-brand">Avis recus</h2>
                {% if avgRating %}
                    <span class="text-sm font-bold text-brand"><span class="text-amber-500">★</span> {{ avgRating }}/5</span>
                {% endif %}
            </div>
            {% if reviews is empty %}
                <p class="text-sm text-brand/40 mt-3">Aucun avis pour le moment.</p>
            {% else %}
                <div class="mt-4 space-y-4">
                    {% for review in reviews %}
                        <div class="flex gap-3">
                            {% if review.author.avatar %}
                                <img src="{{ review.author.avatar }}" alt="" class="w-9 h-9 rounded-full object-cover shrink-0">
                            {% else %}
                                <span class="w-9 h-9 rounded-full bg-cream text-brand text-xs font-bold flex items-center justify-center shrink-0">{{ review.author.firstName|first|upper }}</span>
                            {% endif %}
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-brand">
                                    {{ review.author.firstName }}
                                    <span class="text-amber-500 ml-1">{% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}</span>
                                    <span class="text-xs font-normal text-brand/40 ml-1">{{ review.createdAt|date('m/Y') }}</span>
                                </p>
                                {% if review.comment %}
                                    <p class="text-sm text-brand/60 mt-0.5 leading-relaxed">{{ review.comment }}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{% if isMe %}
<script>
    // Bascule lecture <-> edition sans recharger la page
    (() => {
        const view  = document.querySelector('[data-profile-view]');
        const edit  = document.querySelector('[data-profile-edit]');
        const label = document.querySelector('[data-profile-toggle-label]');
        const sync  = () => { label.textContent = edit.hidden ? 'Modifier' : 'Fermer'; };
        document.querySelectorAll('[data-profile-toggle]').forEach((btn) => {
            btn.addEventListener('click', () => {
                edit.hidden = !edit.hidden;
                view.hidden = !edit.hidden;
                sync();
                if (!edit.hidden) edit.querySelector('input')?.focus();
            });
        });
        sync();
    })();

    // Apercu de la photo choisie, avant meme l'envoi
    (() => {
        const input   = document.querySelector('[data-avatar-input]');
        const preview = document.querySelector('[data-avatar-preview]');
        const remove  = document.querySelector('[data-avatar-remove]');
        if (!input || !preview) return;
        input.addEventListener('change', () => {
            const file = input.files[0];
            if (!file) return;
            if (file.size > 4 * 1024 * 1024) { alertBox('Photo trop lourde (4 Mo maximum).'); input.value = ''; return; }
            preview.src = URL.createObjectURL(file);
            preview.hidden = false;
            if (remove) remove.checked = false;
        });
        remove?.addEventListener('change', () => { preview.hidden = remove.checked; });

        // Message d'erreur sous le champ (pas de alert() du navigateur)
        function alertBox(text) {
            const box = input.closest('[data-avatar-box]').querySelector('.form-error');
            box.innerHTML = '';
            const ul = document.createElement('ul'), li = document.createElement('li');
            li.textContent = text; ul.appendChild(li); box.appendChild(ul);
        }
    })();
</script>
{% endif %}
{% endblock %}
