{% extends 'email/_layout.html.twig' %}
{# Variables : firstName, link (URL signee), minutes (duree de validite) #}
{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;line-height:28px;color:#0F2D24;">Bonjour {{ firstName }},</h1>
    <p style="margin:0 0 24px;font-size:15px;line-height:23px;color:#33463f;">
        Vous avez demande a changer votre mot de passe. Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
        Ce lien fonctionne <strong>{{ minutes }} minutes</strong> et une seule fois.
    </p>
    <a href="{{ link }}" style="display:inline-block;background:#8DC63F;color:#0F2D24;font-weight:700;font-size:15px;text-decoration:none;padding:13px 26px;border-radius:999px;">Choisir un nouveau mot de passe</a>
    <p style="margin:24px 0 0;font-size:13px;line-height:20px;color:#7b8a84;">
        Ce n'est pas vous ? Ignorez simplement cet e-mail : votre mot de passe actuel reste valable.
    </p>
{% endblock %}
