{% extends 'base.html.twig' %}

{% block title %}Réserver — {{ trip.departureCity }} → {{ trip.arrivalCity }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-6 py-12">

    <a href="{{ path('app_trip_show', {id: trip.id}) }}"
       class="text-sm text-brand/50 hover:text-brand flex items-center gap-1 mb-8 transition">
        ← Retour au trajet
    </a>

    <h1 class="text-2xl font-extrabold text-brand mb-8">Réserver ce trajet</h1>

    {# RÉSUMÉ DU TRAJET #}
    <div class="bg-white rounded-2xl border border-black/8 p-6 mb-6">
        <div class="flex items-center gap-4 mb-5">
            {% if trip.driver.avatar %}
                <img src="{{ trip.driver.avatar }}" alt=""
                     class="w-12 h-12 rounded-full object-cover">
            {% else %}
                <div class="w-12 h-12 rounded-full bg-brand/10 flex items-center justify-center font-bold text-brand">
                    {{ trip.driver.firstName|first|upper }}{{ trip.driver.lastName|first|upper }}
                </div>
            {% endif %}
            <div>
                <p class="font-semibold text-brand">{{ trip.driver.firstName }} {{ trip.driver.lastName|first }}.</p>
                <p class="text-sm text-brand/50">{{ trip.driver.tripsCompleted }} trajet{{ trip.driver.tripsCompleted != 1 ? 's' : '' }}</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="flex flex-col items-center">
                <div class="w-2.5 h-2.5 rounded-full bg-lime"></div>
                <div class="w-px h-8 bg-brand/20"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-brand"></div>
            </div>
            <div class="flex flex-col justify-between h-12">
                <div class="flex items-baseline gap-2">
                    <span class="font-bold text-brand">{{ trip.departureAt|date('H:i') }}</span>
                    <span class="text-brand/60 text-sm">{{ trip.departureCity }}</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="font-bold text-brand/30">–</span>
                    <span class="text-brand/60 text-sm">{{ trip.arrivalCity }}</span>
                </div>
            </div>
            <div class="ml-auto text-right">
                <p class="text-xs text-brand/40">{{ trip.departureAt|date('d/m/Y') }}</p>
                <p class="text-sm font-semibold text-brand mt-0.5">
                    {{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' : '' }} disponible{{ trip.availableSeats > 1 ? 's' : '' }}
                </p>
            </div>
        </div>
    </div>

    {# FORMULAIRE #}
    {{ form_start(form, {attr: {class: 'bg-white rounded-2xl border border-black/8 p-6'}}) }}

        <h2 class="font-bold text-brand mb-4">Combien de places souhaitez-vous réserver ?</h2>

        <div class="flex items-center gap-3 border border-black/10 rounded-xl px-4 py-3 mb-6">
            <svg class="w-4 h-4 text-brand/40" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>
            </svg>
            {{ form_widget(form.seats) }}
        </div>

        {# TOTAL #}
        <div class="bg-cream rounded-xl p-4 mb-6 flex items-center justify-between">
            <span class="text-sm font-medium text-brand/60">Prix par place</span>
            <span class="font-bold text-brand">{{ trip.price }}€</span>
        </div>

        <button type="submit"
                class="w-full bg-lime hover:bg-lime-hover text-brand font-bold py-4 rounded-xl transition text-sm flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7"/>
            </svg>
            Confirmer la réservation
        </button>

        <p class="text-center text-xs text-brand/30 mt-3">Annulation gratuite avant le départ</p>

    {{ form_end(form) }}

</div>
{% endblock %}