{% extends 'base.html.twig' %}

{% block title %}Réservation #{{ booking.id }} — Covoite{% endblock %}

{% block body %}

{% set trip = booking.trip %}

{% set statusLabel = {
    'pending':   'En attente de confirmation',
    'confirmed': 'Réservation confirmée',
    'cancelled': 'Annulée',
    'completed': 'Trajet effectué',
} %}
{% set statusClass = {
    'pending':   'bg-amber-50 text-amber-700 border-amber-200',
    'confirmed': 'bg-lime/10 text-brand border-lime/30',
    'cancelled': 'bg-red-50 text-red-700 border-red-200',
    'completed': 'bg-black/5 text-brand/50 border-black/10',
} %}
{% set dotClass = {
    'pending':   'bg-amber-400',
    'confirmed': 'bg-lime',
    'cancelled': 'bg-red-400',
    'completed': 'bg-brand/20',
} %}

<div class="max-w-4xl mx-auto px-6 py-10">

    <a href="{{ path('app_account') }}"
       class="inline-flex items-center gap-1 text-sm text-brand/50 hover:text-brand transition mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour à mon espace
    </a>

    {# EN-TÊTE #}
    <div class="flex items-start justify-between mb-6 flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-extrabold text-brand">
                {{ trip.departureCity }} → {{ trip.arrivalCity }}
            </h1>
            <p class="text-sm text-brand/40 mt-1">
                Réservation n°{{ booking.id }} · réservé le {{ booking.createdAt|date('d/m/Y à H:i') }}
            </p>
        </div>
        <span class="inline-flex items-center gap-2 text-sm font-semibold px-4 py-2 rounded-full border {{ statusClass[booking.status.value] }}">
            <span class="w-1.5 h-1.5 rounded-full {{ dotClass[booking.status.value] }}"></span>
            {{ statusLabel[booking.status.value] }}
        </span>
    </div>

    <div class="grid lg:grid-cols-5 gap-6">

        {# ── COLONNE PRINCIPALE ──────────────────────────────────────────── #}
        <div class="lg:col-span-3 flex flex-col gap-5">

            {# TRAJET #}
            <div class="bg-white rounded-2xl border border-black/8 p-6">
                <h2 class="font-bold text-brand mb-5 text-sm uppercase tracking-widest text-brand/40">Itinéraire</h2>

                <div class="flex flex-col gap-0 mb-4">
                    <div class="flex items-start gap-4 pb-4">
                        <div class="flex flex-col items-center w-5 mt-1 shrink-0">
                            <div class="w-3 h-3 rounded-full bg-lime border-2 border-white shadow ring-2 ring-lime/20"></div>
                            <div class="w-px h-10 bg-brand/15 mt-1"></div>
                        </div>
                        <div class="flex-1">
                            <p class="font-bold text-brand">{{ trip.departureCity }}</p>
                            <p class="text-xs text-brand/40 mt-0.5">{{ trip.departureAddress }}</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="font-bold text-brand text-sm">{{ trip.departureAt|date('H:i') }}</p>
                            <p class="text-xs text-brand/40">{{ trip.departureAt|date('d/m/Y') }}</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="flex flex-col items-center w-5 mt-1 shrink-0">
                            <div class="w-3 h-3 rounded-full bg-brand border-2 border-white shadow"></div>
                        </div>
                        <div class="flex-1">
                            <p class="font-bold text-brand">{{ trip.arrivalCity }}</p>
                            <p class="text-xs text-brand/40 mt-0.5">{{ trip.arrivalAddress }}</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-brand/30 text-sm font-bold">—</p>
                        </div>
                    </div>
                </div>

                {# CARTE #}
                <div class="mt-5 rounded-xl overflow-hidden border border-black/6" style="height: 200px;" id="map">
                    <div class="w-full h-full bg-cream flex items-center justify-center text-sm text-brand/30" id="map-placeholder">
                        Carte indisponible (coordonnées manquantes)
                    </div>
                </div>
            </div>

            {# CONDUCTEUR #}
            <div class="bg-white rounded-2xl border border-black/8 p-6">
                <h2 class="font-bold text-brand mb-4 text-sm uppercase tracking-widest text-brand/40">Conducteur</h2>
                <div class="flex items-center gap-4">
                    {% if trip.driver.avatar %}
                        <img src="{{ trip.driver.avatar }}" class="w-12 h-12 rounded-full object-cover" alt="">
                    {% else %}
                        <div class="w-12 h-12 rounded-full bg-brand flex items-center justify-center shrink-0">
                            <span class="text-sm font-bold text-lime">
                                {{ trip.driver.firstName|first|upper }}{{ trip.driver.lastName|first|upper }}
                            </span>
                        </div>
                    {% endif %}
                    <div>
                        <p class="font-bold text-brand">{{ trip.driver.firstName }} {{ trip.driver.lastName|first }}.</p>
                        <a href="{{ path('app_trip_show', {id: trip.id}) }}"
                           class="text-xs text-brand/40 hover:text-brand transition underline underline-offset-2">
                            Voir l'annonce
                        </a>
                    </div>
                </div>
            </div>

            {# CONTACT (à brancher plus tard) #}
            <div class="bg-white rounded-2xl border border-black/8 p-6">
                <h2 class="font-bold text-brand mb-4 text-sm uppercase tracking-widest text-brand/40">Contacter le conducteur</h2>
                <div class="flex flex-col gap-2">
                    <button disabled
                            class="flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl border border-black/8 bg-cream text-sm font-semibold text-brand/40 cursor-not-allowed">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        Envoyer un message
                        <span class="ml-auto text-xs font-normal text-brand/25">Bientôt disponible</span>
                    </button>
                    <button disabled
                            class="flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl border border-black/8 bg-cream text-sm font-semibold text-brand/40 cursor-not-allowed">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Appeler le conducteur
                        <span class="ml-auto text-xs font-normal text-brand/25">Bientôt disponible</span>
                    </button>
                    <button disabled
                            class="flex items-center gap-3 w-full text-left px-4 py-3 rounded-xl border border-black/8 bg-cream text-sm font-semibold text-brand/40 cursor-not-allowed">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                        </svg>
                        Signaler un problème
                        <span class="ml-auto text-xs font-normal text-brand/25">Bientôt disponible</span>
                    </button>
                </div>
            </div>

            {# ANNULATION #}
            {% if booking.status.value in ['pending', 'confirmed'] %}
                <div class="bg-white rounded-2xl border border-black/8 p-6">
                    <h2 class="font-bold text-brand mb-2 text-sm uppercase tracking-widest text-brand/40">Annuler</h2>
                    <p class="text-sm text-brand/50 mb-4">
                        Vous pouvez annuler votre réservation. Le remboursement suit nos conditions générales.
                    </p>
                    <form method="post" action="{{ path('app_booking_cancel', {id: booking.id}) }}"
                          onsubmit="return confirm('Confirmer l\'annulation de cette réservation ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel-booking-' ~ booking.id) }}">
                        <button type="submit"
                                class="inline-flex items-center gap-2 bg-red-50 hover:bg-red-100 text-red-700 font-semibold text-sm px-5 py-2.5 rounded-xl transition border border-red-200">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                            Annuler ma réservation
                        </button>
                    </form>
                </div>
            {% endif %}

        </div>

        {# ── RÉCAP SIDEBAR ───────────────────────────────────────────────── #}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl border border-black/8 p-6 sticky top-24 flex flex-col gap-4">

                <h2 class="font-bold text-brand text-sm uppercase tracking-widest text-brand/40">Récapitulatif</h2>

                <div class="flex justify-between py-3 border-b border-black/6 text-sm">
                    <span class="text-brand/60">Places</span>
                    <span class="font-bold text-brand">{{ booking.seats }}</span>
                </div>

                <div class="flex justify-between py-3 border-b border-black/6 text-sm">
                    <span class="text-brand/60">Prix par place</span>
                    <span class="font-semibold text-brand">{{ trip.price }} €</span>
                </div>

                <div class="flex justify-between py-3 border-b border-black/6">
                    <span class="text-sm font-bold text-brand">Total</span>
                    <span class="font-extrabold text-brand text-xl">{{ booking.amount }} €</span>
                </div>

                {% if booking.message %}
                    <div class="bg-cream rounded-xl p-4">
                        <p class="text-xs text-brand/40 mb-1 font-semibold uppercase tracking-widest">Votre message</p>
                        <p class="text-sm text-brand/70 leading-relaxed">{{ booking.message }}</p>
                    </div>
                {% endif %}

            </div>
        </div>

    </div>
</div>

{# CARTE LEAFLET #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const depLat = {{ trip.departureLat ?: 'null' }};
    const depLng = {{ trip.departureLng ?: 'null' }};
    const arrLat = {{ trip.arrivalLat ?: 'null' }};
    const arrLng = {{ trip.arrivalLng ?: 'null' }};

    const mapEl = document.getElementById('map');
    const placeholder = document.getElementById('map-placeholder');

    if (!depLat || !depLng || !arrLat || !arrLng) return;

    placeholder.remove();

    const map = L.map(mapEl, { zoomControl: false });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    const greenDot = L.divIcon({
        className: '',
        html: '<div style="width:12px;height:12px;background:#8DC63F;border:2px solid white;border-radius:50%;box-shadow:0 0 0 3px rgba(141,198,63,.25)"></div>',
        iconAnchor: [6, 6]
    });
    const darkDot = L.divIcon({
        className: '',
        html: '<div style="width:12px;height:12px;background:#0F2D24;border:2px solid white;border-radius:50%;box-shadow:0 1px 4px rgba(0,0,0,.2)"></div>',
        iconAnchor: [6, 6]
    });

    L.marker([depLat, depLng], { icon: greenDot }).addTo(map);
    L.marker([arrLat, arrLng], { icon: darkDot  }).addTo(map);

    L.polyline([[depLat, depLng], [arrLat, arrLng]], {
        color: '#8DC63F', weight: 3, dashArray: '6 8', opacity: 0.7
    }).addTo(map);

    map.fitBounds([[depLat, depLng], [arrLat, arrLng]], { padding: [24, 24] });
});
</script>

{% endblock %}