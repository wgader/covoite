{% extends 'base.html.twig' %}

{% block title %}Messages — Covoite{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-6 py-10">

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-extrabold text-brand">Messages</h1>
            <p class="text-sm text-brand/40 mt-1">Vos conversations avec d'autres membres.</p>
        </div>
    </div>

    {% if conversations is empty %}
        <div class="bg-white border border-black/6 rounded-2xl p-16 text-center">
            <div class="w-16 h-16 bg-cream rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-brand/25" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/>
                </svg>
            </div>
            <p class="text-brand font-semibold mb-2">Aucun message</p>
            <p class="text-sm text-brand/40">Envoyez un message a un conducteur depuis la page d'un trajet.</p>
        </div>
    {% else %}
        <div class="bg-white border border-black/6 rounded-2xl divide-y divide-black/5 overflow-hidden">
            {% for item in conversations %}
                {% set partner = item.partner %}
                {% set lastMsg = item.lastMessage %}
                {% set isUnread = item.unreadCount > 0 %}

                <a href="{{ path('app_message_thread', {id: partner.id}) }}"
                   class="flex items-start gap-4 px-5 py-4 hover:bg-cream/60 transition group">

                    {# Avatar partenaire #}
                    {% if partner.avatar %}
                        <img src="{{ partner.avatar }}" alt=""
                             class="w-10 h-10 rounded-full object-cover flex-shrink-0 mt-0.5">
                    {% else %}
                        <div class="w-10 h-10 rounded-full bg-brand flex items-center justify-center flex-shrink-0 mt-0.5">
                            <span class="text-sm font-bold text-lime">{{ partner.firstName|first|upper }}</span>
                        </div>
                    {% endif %}

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-2 mb-0.5">
                            <span class="font-semibold text-brand text-sm {% if isUnread %}font-bold{% endif %}">
                                {{ partner.firstName }} {{ partner.lastName|first }}.
                            </span>
                            {% if lastMsg %}
                                <span class="text-xs text-brand/30 flex-shrink-0">
                                    {{ lastMsg.sentAt|date('d/m/Y') }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="flex items-center gap-2">
                            {% if lastMsg %}
                                {% if lastMsg.sender.id == app.user.id %}
                                    <span class="text-xs text-brand/30 flex-shrink-0">Vous :</span>
                                {% endif %}
                                <p class="text-sm text-brand/50 truncate {% if isUnread %}text-brand font-medium{% endif %}">
                                    {{ lastMsg.content|u.truncate(80, '…') }}
                                </p>
                            {% else %}
                                <p class="text-sm text-brand/30 italic">Aucun message</p>
                            {% endif %}

                            {% if isUnread %}
                                <span class="w-2 h-2 bg-lime rounded-full flex-shrink-0"></span>
                            {% endif %}
                        </div>

                        {% if item.trip %}
                            <p class="text-xs text-brand/30 mt-0.5">
                                Re : {{ item.trip.departureCity }} &rarr; {{ item.trip.arrivalCity }}
                            </p>
                        {% endif %}
                    </div>

                    <svg class="w-4 h-4 text-brand/20 group-hover:text-brand/40 transition flex-shrink-0 mt-3"
                         fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}