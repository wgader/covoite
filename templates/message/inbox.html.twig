{% extends 'base.html.twig' %}

{% block title %}Messages — Covoite{% endblock %}

{# Pas de footer : la messagerie prend tout l'ecran, comme une appli #}
{% block footer %}{% endblock %}

{% block body %}
<div class="h-[calc(100dvh-4rem)] max-w-6xl mx-auto sm:px-6 sm:py-6 flex">
    <div class="flex-1 flex min-w-0 bg-white sm:rounded-3xl sm:border sm:border-black/5 sm:shadow-card overflow-hidden">

        {# ── Liste ── #}
        <aside class="w-full md:w-[360px] md:border-r md:border-black/5 flex flex-col min-h-0">
            {% include 'message/_conversations.html.twig' %}
        </aside>

        {# ── Panneau vide (ordinateur uniquement) ── #}
        <section class="hidden md:flex flex-1 flex-col items-center justify-center text-center px-10 bg-cream/40">
            <div class="w-20 h-20 rounded-3xl bg-white border border-black/5 shadow-card text-brand flex items-center justify-center">
                <svg class="w-9 h-9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/></svg>
            </div>
            <h2 class="text-xl font-extrabold text-brand mt-6">Vos messages</h2>
            <p class="text-sm text-brand/50 mt-2 max-w-xs leading-relaxed">
                Choisissez une conversation pour la lire, ou contactez un conducteur depuis la page d'un trajet.
            </p>
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {% include 'message/_list_search.html.twig' %}
{% endblock %}
