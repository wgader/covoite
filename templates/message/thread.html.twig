{% extends 'base.html.twig' %}

{% block title %}{{ partner.firstName }} — Messages — Covoite{% endblock %}

{% block footer %}{% endblock %}

{% block body %}
{% set today     = 'now'|date('Y-m-d') %}
{% set yesterday = '-1 day'|date('Y-m-d') %}
{% set lastMine  = null %}
{% for m in thread %}{% if m.sender.id == app.user.id %}{% set lastMine = m %}{% endif %}{% endfor %}

<div class="h-[calc(100dvh-4rem)] max-w-6xl mx-auto sm:px-6 sm:py-6 flex">
    <div class="flex-1 flex min-w-0 bg-white sm:rounded-3xl sm:border sm:border-black/5 sm:shadow-card overflow-hidden">

        {# ── Liste (cachee sur mobile quand une discussion est ouverte) ── #}
        <aside class="hidden md:flex w-[360px] border-r border-black/5 flex-col min-h-0" data-conv-aside>
            {% include 'message/_conversations.html.twig' %}
        </aside>

        {# ══════════ DISCUSSION ══════════ #}
        <section class="flex-1 flex flex-col min-w-0 min-h-0">

            {# ── En-tete ── #}
            <header class="flex items-center gap-3 px-3 sm:px-5 h-[72px] border-b border-black/5 shrink-0">
                <a href="{{ path('app_messages') }}" aria-label="Retour aux conversations"
                   class="md:hidden w-10 h-10 rounded-full flex items-center justify-center text-brand hover:bg-cream transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <a href="{{ path('app_profile_show', {id: partner.id}) }}" class="flex items-center gap-3 min-w-0 group">
                    {% if partner.avatar %}
                        <img src="{{ partner.avatar }}" alt="" class="w-11 h-11 rounded-full object-cover">
                    {% else %}
                        <span class="w-11 h-11 rounded-full bg-brand text-lime font-bold flex items-center justify-center">{{ partner.firstName|first|upper }}</span>
                    {% endif %}
                    <span class="min-w-0">
                        <span class="block text-base font-extrabold text-brand truncate group-hover:underline">{{ partner.firstName }} {{ partner.lastName|first }}.</span>
                        <span class="block text-xs text-brand/50">Voir le profil</span>
                    </span>
                </a>
            </header>

            {# ── Trajet concerne ── #}
            {% if trip %}
                <a href="{{ path('app_trip_show', {id: trip.id}) }}"
                   class="flex items-center gap-3 px-4 sm:px-5 py-3 bg-lime-soft/60 border-b border-lime/20 hover:bg-lime-soft transition shrink-0">
                    <span class="w-9 h-9 rounded-xl bg-white text-brand flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 17h14M5 17a2 2 0 1 0 4 0M15 17a2 2 0 1 0 4 0M3 17v-4l2-5a2 2 0 0 1 1.9-1.4h10.2A2 2 0 0 1 19 8l2 5v4"/></svg>
                    </span>
                    <span class="flex-1 min-w-0">
                        <span class="block text-sm font-bold text-brand truncate">{{ trip.departureCity }} &rarr; {{ trip.arrivalCity }}</span>
                        <span class="block text-xs text-brand/60 first-letter:uppercase">{{ trip.departureAt|date_fr }} a {{ trip.departureAt|date('H\\hi') }} · {{ trip.price|number_format(2, ',', ' ') }} &euro;</span>
                    </span>
                    <span class="hidden sm:inline text-xs font-semibold text-brand">Voir le trajet</span>
                    <svg class="w-4 h-4 text-brand/50" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            {% endif %}

            {# ── Messages ── #}
            <div class="flex-1 overflow-y-auto bg-cream/40 px-3 sm:px-6 py-5" data-scroll>
                <div data-messages data-last-id="{{ thread is empty ? 0 : (thread|last).id }}">
                    {% if thread is empty %}
                        <div class="h-full min-h-[50vh] flex flex-col items-center justify-center text-center px-6">
                            {% if partner.avatar %}
                                <img src="{{ partner.avatar }}" alt="" class="w-20 h-20 rounded-full object-cover ring-4 ring-white shadow-card">
                            {% else %}
                                <span class="w-20 h-20 rounded-full bg-brand text-lime text-2xl font-extrabold flex items-center justify-center ring-4 ring-white shadow-card">{{ partner.firstName|first|upper }}</span>
                            {% endif %}
                            <p class="text-lg font-extrabold text-brand mt-5">Dites bonjour a {{ partner.firstName }}</p>
                            <p class="text-sm text-brand/50 mt-1 max-w-xs">Posez vos questions avant de reserver : point de rendez-vous, bagages, horaires...</p>
                            <div class="flex flex-wrap justify-center gap-2 mt-6 max-w-md">
                                {% for s in [
                                    'Bonjour ! Il vous reste de la place ?',
                                    'Ou est le point de rendez-vous exact ?',
                                    'Je peux prendre une valise ?',
                                ] %}
                                    <button type="button" data-suggest="{{ s }}"
                                            class="text-sm font-medium text-brand bg-white border border-black/10 hover:border-brand/30 px-4 py-2 rounded-full transition">{{ s }}</button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% for msg in thread %}
                        {% set isMe   = msg.sender.id == app.user.id %}
                        {% set prev   = loop.first ? null : thread[loop.index0 - 1] %}
                        {% set next   = loop.last ? null : thread[loop.index0 + 1] %}
                        {% set day    = msg.sentAt|date('Y-m-d') %}
                        {% set newDay = prev is null or prev.sentAt|date('Y-m-d') != day %}
                        {# Un "groupe" = messages consecutifs du meme auteur, le meme jour, a moins de 5 min d'ecart #}
                        {% set startsGroup = newDay or prev.sender.id != msg.sender.id or (msg.sentAt|date('U') - prev.sentAt|date('U')) > 300 %}
                        {% set endsGroup   = next is null or next.sender.id != msg.sender.id or next.sentAt|date('Y-m-d') != day or (next.sentAt|date('U') - msg.sentAt|date('U')) > 300 %}

                        {% if newDay %}
                            <div class="flex justify-center my-5 first:mt-0">
                                <span class="text-[11px] font-semibold text-brand/50 bg-white border border-black/5 rounded-full px-3 py-1 first-letter:uppercase">
                                    {% if day == today %}Aujourd'hui{% elseif day == yesterday %}Hier{% else %}{{ msg.sentAt|date_fr('long') }}{% endif %}
                                </span>
                            </div>
                        {% endif %}

                        <div class="flex items-end gap-2 {{ isMe ? 'justify-end' : 'justify-start' }} {{ startsGroup ? 'mt-3' : 'mt-0.5' }} group/msg">

                            {% if not isMe %}
                                {% if endsGroup %}
                                    {% if msg.sender.avatar %}
                                        <img src="{{ msg.sender.avatar }}" alt="" class="w-7 h-7 rounded-full object-cover shrink-0">
                                    {% else %}
                                        <span class="w-7 h-7 rounded-full bg-brand text-lime text-[11px] font-bold flex items-center justify-center shrink-0">{{ msg.sender.firstName|first|upper }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="w-7 shrink-0"></span>
                                {% endif %}
                            {% endif %}

                            {% if isMe %}
                                {# Supprimer : visible au survol (ordinateur) #}
                                <form method="post" action="{{ path('app_message_delete', {id: msg.id}) }}"
                                      class="opacity-0 group-hover/msg:opacity-100 focus-within:opacity-100 transition self-center"
                                      data-confirm="Le message disparaitra pour vous deux."
                                      data-confirm-title="Supprimer ce message ?"
                                      data-confirm-button="Supprimer"
                                      data-confirm-tone="danger">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-message-' ~ msg.id) }}">
                                    <button aria-label="Supprimer ce message" class="w-8 h-8 rounded-full text-brand/30 hover:text-red-600 hover:bg-white flex items-center justify-center transition">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
                                    </button>
                                </form>
                            {% endif %}

                            <div class="max-w-[78%] sm:max-w-[65%] flex flex-col {{ isMe ? 'items-end' : 'items-start' }}">
                                <div class="px-4 py-2.5 text-[15px] leading-relaxed whitespace-pre-wrap break-words
                                    {{ isMe ? 'bg-brand text-cream' : 'bg-white text-brand border border-black/5' }}
                                    rounded-[22px]
                                    {# Coin "colle" du cote de l'auteur, comme dans les applis de messagerie #}
                                    {{ isMe ? 'rounded-br-md' : 'rounded-bl-md' }}
                                    {{ not startsGroup ? (isMe ? 'rounded-tr-md' : 'rounded-tl-md') }}"
                                    title="{{ msg.sentAt|date('d/m/Y H:i') }}">{{ msg.content }}</div>

                                {% if endsGroup %}
                                    <p class="text-[11px] text-brand/40 mt-1 px-1 flex items-center gap-1">
                                        {{ msg.sentAt|date('H:i') }}
                                        {% if isMe and lastMine and msg.id == lastMine.id %}
                                            {% if partnerLastRead is not null and msg.sentAt <= partnerLastRead %}
                                                <span class="inline-flex items-center gap-0.5 text-lime font-semibold">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path d="m2 13 4 4L16 7M10 15l2 2 10-10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                    Lu
                                                </span>
                                            {% else %}
                                                <span class="inline-flex items-center gap-0.5">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                                    Envoye
                                                </span>
                                            {% endif %}
                                        {% endif %}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# ── Zone d'ecriture ── #}
            <form method="post" action="{{ path('app_message_thread', {id: partner.id}) }}" data-composer
                  class="shrink-0 border-t border-black/5 bg-white px-3 sm:px-5 py-3">
                <input type="hidden" name="_token" value="{{ csrf_token('send-message') }}">
                {% if trip %}<input type="hidden" name="trip_id" value="{{ trip.id }}">{% endif %}
                <div class="flex items-end gap-2">
                    <label class="flex-1 bg-cream rounded-3xl px-4 py-2.5 focus-within:ring-4 focus-within:ring-lime/20 transition">
                        <span class="sr-only">Votre message</span>
                        <textarea name="body" rows="1" maxlength="{{ maxLength }}" data-input
                                  placeholder="Ecrire a {{ partner.firstName }}..."
                                  class="block w-full bg-transparent resize-none outline-none text-[15px] text-brand placeholder:text-brand/40 max-h-40 leading-6"></textarea>
                    </label>
                    <button type="submit" data-send disabled aria-label="Envoyer"
                            class="w-12 h-12 shrink-0 rounded-full bg-lime hover:bg-lime-hover text-brand flex items-center justify-center transition disabled:bg-black/5 disabled:text-brand/30">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12 3 4l18 8-18 8z"/><path d="M5 12h7"/></svg>
                    </button>
                </div>
                <p class="hidden sm:block text-[11px] text-brand/30 mt-1.5 pl-4">Entree pour envoyer · Maj + Entree pour aller a la ligne</p>
            </form>
        </section>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {% include 'message/_list_search.html.twig' %}
<script>
(() => {
    const scroller = document.querySelector('[data-scroll]');
    const input    = document.querySelector('[data-input]');
    const send     = document.querySelector('[data-send]');
    const composer = document.querySelector('[data-composer]');
    const toBottom = () => { scroller.scrollTop = scroller.scrollHeight; };
    toBottom();

    // Le champ grandit avec le texte (jusqu'a ~6 lignes)
    const grow = () => {
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 160) + 'px';
        send.disabled = input.value.trim() === '';
    };
    input.addEventListener('input', grow);

    // Entree = envoyer, Maj+Entree = nouvelle ligne
    input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
            e.preventDefault();
            if (input.value.trim()) composer.requestSubmit();
        }
    });
    composer.addEventListener('submit', () => { send.disabled = true; });

    // Suggestions de premier message
    document.querySelectorAll('[data-suggest]').forEach((b) => b.addEventListener('click', () => {
        input.value = b.dataset.suggest; grow(); input.focus();
    }));

    if (window.matchMedia('(min-width: 768px)').matches) input.focus();

    // ── Nouveaux messages ──
    // On recharge la page en arriere-plan et on remplace juste les messages, la liste et le compteur.
    const refresh = async () => {
        try {
            const res  = await fetch(window.location.href, { headers: { 'X-Requested-With': 'fetch' } });
            if (!res.ok) return;
            const doc  = new DOMParser().parseFromString(await res.text(), 'text/html');
            const now  = document.querySelector('[data-messages]');
            const next = doc.querySelector('[data-messages]');
            if (next && next.dataset.lastId !== now.dataset.lastId) {
                const atBottom = scroller.scrollHeight - scroller.scrollTop - scroller.clientHeight < 80;
                now.replaceWith(next);
                if (atBottom) toBottom();
                document.querySelectorAll('[data-suggest]').forEach((b) => b.addEventListener('click', () => { input.value = b.dataset.suggest; grow(); input.focus(); }));
            }
            const list = document.querySelector('[data-conv-list]'), nextList = doc.querySelector('[data-conv-list]');
            if (list && nextList) list.innerHTML = nextList.innerHTML;
            // Compteur "messages non lus" de la barre du haut (la discussion ouverte est maintenant lue)
            const badge = doc.querySelector('[data-live-badge="messages"]');
            if (badge) document.querySelectorAll('[data-live-badge="messages"]').forEach((b) => { b.hidden = badge.hidden; b.textContent = badge.textContent; });
        } catch (e) { /* hors ligne : on reessaiera */ }
    };

    // 1) En direct (Mercure) : un message de cette personne arrive -> on recharge tout de suite
    const partnerId = {{ partner.id }};
    window.addEventListener('covoite:live', (e) => {
        if (e.detail.type === 'message' && e.detail.from === partnerId) refresh();
    });

    // 2) Filet de securite si le direct ne marche pas : toutes les 8 s (30 s si le direct marche)
    let last = Date.now();
    setInterval(() => {
        if (document.hidden) return;
        if (Date.now() - last < (window.covoiteLive ? 30000 : 8000)) return;
        last = Date.now();
        refresh();
    }, 2000);
})();
</script>
{% endblock %}
