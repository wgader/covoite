{% extends 'base.html.twig' %}

{% block title %}Conversation avec {{ partner.firstName }} — Covoite{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-6 py-10">

        {# En-tete #}
        <div class="flex items-center gap-4 mb-6">
            <a
                href="{{ path('app_messages') }}"
                class="w-9 h-9 rounded-xl bg-white border border-black/8 flex items-center justify-center hover:border-brand/20 transition flex-shrink-0"
            >
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>

            {% if partner.avatar %}
                <img
                    src="{{ partner.avatar }}"
                    alt=""
                    class="w-10 h-10 rounded-full object-cover flex-shrink-0"
                >
            {% else %}
                <div class="w-10 h-10 rounded-full bg-brand flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-lime">{{ partner.firstName|first|upper }}</span>
                </div>
            {% endif %}
            <div>
                <h1 class="font-extrabold text-brand text-lg leading-none">
                    {{ partner.firstName }} {{ partner.lastName|first }}.
                </h1>
                <a
                    href="{{ path('app_profile_show', {id: partner.id}) }}"
                    class="text-xs text-brand/40 hover:text-lime transition"
                >
                    Voir le profil
                </a>
            </div>
        </div>

        {# Contexte trajet si present #}
        {% if trip %}
            <div class="bg-white border border-lime/30 rounded-xl px-4 py-3 mb-6 flex items-center gap-3">
                <svg class="w-5 h-5 text-lime flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                </svg>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-brand">
                        {{ trip.departureCity }} &rarr; {{ trip.arrivalCity }}
                    </p>
                    <p class="text-xs text-brand/40">{{ trip.departureAt|date('d/m/Y a H\hi') }}</p>
                </div>
                <a
                    href="{{ path('app_trip_show', {id: trip.id}) }}"
                    class="text-xs text-lime font-semibold hover:underline flex-shrink-0"
                >
                    Voir le trajet
                </a>
            </div>
        {% endif %}

        {# Fil de messages #}
        <div class="space-y-3 mb-8" id="thread">
            {% for msg in thread %}
                {% set isMe = msg.sender.id == app.user.id %}
                {% set isRead = isMe and partnerLastRead is not null and msg.sentAt <= partnerLastRead %}
                <div class="flex {% if isMe %}justify-end{% else %}justify-start{% endif %} items-end gap-2">

                    {% if not isMe %}
                        {% if msg.sender.avatar %}
                            <img
                                src="{{ msg.sender.avatar }}"
                                alt=""
                                class="w-7 h-7 rounded-full object-cover flex-shrink-0"
                            >
                        {% else %}
                            <div class="w-7 h-7 rounded-full bg-brand flex items-center justify-center flex-shrink-0">
                                <span class="text-xs font-bold text-lime">{{ msg.sender.firstName|first|upper }}</span>
                            </div>
                        {% endif %}
                    {% endif %}

                    <div class="max-w-[75%]">
                        <div
                            class="rounded-2xl px-4 py-2.5
                        {% if isMe %}bg-brand text-cream rounded-br-sm{% else %}bg-white border border-black/8 text-brand rounded-bl-sm{% endif %}"
                        >
                            <p class="text-sm leading-relaxed whitespace-pre-wrap">{{ msg.content }}</p>
                        </div>
                        <p class="text-[11px] text-brand/30 mt-1 {% if isMe %}text-right{% endif %}">
                            {{ msg.sentAt|date('d/m a H\hi') }}
                            {% if isRead %}
                                <span class="text-lime ml-1">Lu</span>
                            {% endif %}
                        </p>
                    </div>

                </div>
            {% else %}
                <p class="text-center text-sm text-brand/30 py-8">
                    Envoyez votre premier message a {{ partner.firstName }}.
                </p>
            {% endfor %}
        </div>

        {# Formulaire d'envoi #}
        <form
            method="POST"
            action="{{ path('app_message_thread', {id: partner.id}) }}"
            class="bg-white border border-black/8 rounded-2xl p-4"
        >
            <input type="hidden" name="_token" value="{{ csrf_token('send-message') }}">
            {% if trip %}
                <input type="hidden" name="trip_id" value="{{ trip.id }}">
            {% endif %}

            <textarea name="body" rows="3" required minlength="5"
                  placeholder="Votre message..."
                  class="w-full text-sm text-brand placeholder:text-brand/30 outline-none resize-none bg-transparent"></textarea>

            <div class="flex justify-end mt-3 pt-3 border-t border-black/6">
                <button
                    type="submit"
                    class="flex items-center gap-2 bg-lime hover:bg-lime-hover text-brand font-semibold text-sm px-5 py-2.5 rounded-xl transition"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12zm0 0h7.5"
                        />
                    </svg>
                    Envoyer
                </button>
            </div>
        </form>

    </div>
{% endblock %}
