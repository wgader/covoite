{#
    Colonne de gauche : liste des conversations.
    Variables : conversations (depuis MessageRepository::findConversationsFor), activePartnerId
#}
{% set today     = 'now'|date('Y-m-d') %}
{% set yesterday = '-1 day'|date('Y-m-d') %}

<div class="px-5 pt-5 pb-3 border-b border-black/5">
    <h1 class="text-2xl font-extrabold text-brand tracking-tight">Messages</h1>
    {% if conversations|length > 3 %}
        <label class="relative block mt-4">
            <svg class="w-4 h-4 text-brand/40 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
            <input type="search" data-conv-search placeholder="Rechercher une personne"
                   class="w-full bg-cream rounded-full pl-10 pr-4 py-2.5 text-sm text-brand placeholder:text-brand/40 outline-none focus:ring-4 focus:ring-lime/20">
        </label>
    {% endif %}
</div>

<div class="flex-1 overflow-y-auto" data-conv-list>
    {% for item in conversations %}
        {% set partner  = item.partner %}
        {% if partner %}
            {% set last     = item.lastMessage %}
            {% set unread   = item.unreadCount > 0 %}
            {% set isActive = activePartnerId == partner.id %}
            <a href="{{ path('app_message_thread', {id: partner.id}) }}"
               data-conv-item data-name="{{ (partner.firstName ~ ' ' ~ partner.lastName)|lower }}"
               class="flex items-center gap-3 px-4 py-3.5 mx-2 my-0.5 rounded-2xl transition
                      {{ isActive ? 'bg-lime-soft' : 'hover:bg-cream' }}">
                <span class="relative shrink-0">
                    {% if partner.avatar %}
                        <img src="{{ partner.avatar }}" alt="" class="w-12 h-12 rounded-full object-cover">
                    {% else %}
                        <span class="w-12 h-12 rounded-full bg-brand text-lime font-bold flex items-center justify-center">{{ partner.firstName|first|upper }}</span>
                    {% endif %}
                    {% if unread %}
                        <span class="absolute -top-0.5 -right-0.5 min-w-[20px] h-5 px-1 rounded-full bg-lime text-brand text-[11px] font-bold flex items-center justify-center ring-2 ring-white">{{ item.unreadCount }}</span>
                    {% endif %}
                </span>

                <span class="flex-1 min-w-0">
                    <span class="flex items-baseline justify-between gap-2">
                        <span class="text-sm truncate {{ unread ? 'font-extrabold text-brand' : 'font-semibold text-brand' }}">
                            {{ partner.firstName }} {{ partner.lastName|first }}.
                        </span>
                        {% if last %}
                            {% set d = last.sentAt|date('Y-m-d') %}
                            <span class="text-[11px] shrink-0 {{ unread ? 'text-brand font-bold' : 'text-brand/40' }}">
                                {% if d == today %}{{ last.sentAt|date('H:i') }}{% elseif d == yesterday %}Hier{% else %}{{ last.sentAt|date('d/m') }}{% endif %}
                            </span>
                        {% endif %}
                    </span>
                    <span class="block text-[13px] truncate mt-0.5 {{ unread ? 'text-brand font-medium' : 'text-brand/50' }}">
                        {% if last %}
                            {% if last.sender.id == app.user.id %}Vous : {% endif %}{{ last.content }}
                        {% else %}
                            Nouvelle conversation
                        {% endif %}
                    </span>
                    {% if item.trip %}
                        <span class="inline-flex items-center gap-1 mt-1.5 text-[11px] font-semibold text-brand/60 bg-cream rounded-full px-2 py-0.5 max-w-full">
                            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="truncate">{{ item.trip.departureCity }} - {{ item.trip.arrivalCity }}</span>
                        </span>
                    {% endif %}
                </span>
            </a>
        {% endif %}
    {% else %}
        <div class="px-6 py-14 text-center">
            <div class="w-14 h-14 rounded-2xl bg-lime-soft text-brand mx-auto flex items-center justify-center">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <p class="text-sm font-bold text-brand mt-4">Aucune conversation</p>
            <p class="text-xs text-brand/50 mt-1 leading-relaxed">Ecrivez a un conducteur depuis la page d'un trajet pour commencer.</p>
            <a href="{{ path('app_search') }}" class="inline-block mt-5 text-sm font-semibold bg-lime hover:bg-lime-hover text-brand px-5 py-2.5 rounded-full transition">Trouver un trajet</a>
        </div>
    {% endfor %}
    <p data-conv-empty hidden class="px-6 py-10 text-center text-sm text-brand/40">Personne ne correspond.</p>
</div>
